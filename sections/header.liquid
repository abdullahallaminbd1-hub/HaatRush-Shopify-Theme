<header class="lf-header" data-header>
  <div class="lf-header__bar page-width">
    <div class="lf-header__icons lf-header__icons--left">
      <button class="lf-header__icon lf-header__icon--menu" data-menu-open aria-label="মেনু" aria-expanded="false">
        {% render 'icon', icon: 'menu' %}
      </button>
      <button class="lf-header__icon" data-search-open aria-label="খুঁজুন">
        {% render 'icon', icon: 'search' %}
      </button>
    </div>

    <a class="lf-header__heading" href="{{ routes.root_url }}" role="heading" aria-level="2">
      {%- if section.settings.logo != blank -%}
        <img
          class="lf-header__logo-img"
          src="{{ section.settings.logo | image_url: width: 600 }}"
          srcset="{{ section.settings.logo | image_url: width: 150 }} 150w, {{ section.settings.logo | image_url: width: 300 }} 300w, {{ section.settings.logo | image_url: width: 450 }} 450w, {{ section.settings.logo | image_url: width: 600 }} 600w"
          sizes="(max-width: 989px) 150px, {{ section.settings.logo_width | default: 180 }}px"
          alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          loading="eager"
          style="width:{{ section.settings.logo_width | default: 180 }}px">
      {%- else -%}
        <span class="lf-wordmark">Haat<i>Rush</i></span>
        <span class="lf-wordmark-tag">গ্যাজেট · গেমিং · ফ্যাশন</span>
      {%- endif -%}
    </a>

    {%- comment -%}
      A small set of real popular products, rendered server-side straight from the
      live catalog, used only for the focused-but-empty suggestion state. Nothing
      here is hardcoded and no data is faked. Hidden from layout (script island); ignored entirely on mobile where the desktop field is display:none.
    {%- endcomment -%}
    <form class="lf-header__search" action="{{ routes.search_url }}" method="get" role="search" data-search-suggest-form>
      <span class="lf-header__search-icon" aria-hidden="true">{% render 'icon', icon: 'search' %}</span>
      <input type="search" name="q" placeholder="গ্যাজেট, গেমিং, ফ্যাশন খুঁজুন..." aria-label="খুঁজুন" autocomplete="off" data-search-suggest-input role="combobox" aria-expanded="false" aria-controls="HaatRushSearchSuggest" aria-autocomplete="list" aria-haspopup="listbox">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" aria-label="খুঁজুন">{% render 'icon', icon: 'arrow' %}</button>
      <div class="lf-search-suggest" id="HaatRushSearchSuggest" data-search-suggest-panel hidden></div>
    </form>

    {%- comment -%}
      A small set of real popular products, rendered server-side straight from the
      live catalog, used only for the focused-but-empty suggestion state. Nothing
      here is hardcoded and no data is faked. Hidden from layout (script island); ignored entirely on mobile where the desktop field is display:none.
    {%- endcomment -%}
    <script type="application/json" data-haatrush-popular>
      {%- for pop in collections.all.products limit: 6 -%}
      {
        "title": {{ pop.title | json }},
        "url": {{ pop.url | json }},
        "image": {% if pop.featured_image %}{{ pop.featured_image | image_url: width: 120 | json }}{% else %}""{% endif %},
        "price": {{ pop.price | default: 0 | json }},
        "compare_at_price": {{ pop.compare_at_price | json }},
        "available": {{ pop.available | json }}
      }{%- unless forloop.last -%},{%- enduntil -%}
      {%- endfor -%}
    ]</script>

    <div class="lf-header__icons lf-header__icons--right">
      <a class="lf-header__icon lf-header__icon--account" href="{{ routes.account_login_url }}" aria-label="Log in">
        <span class="lf-header__icon-wrap">{% render 'icon', icon: 'user' %}</span>
        <span class="lf-header__icon-wrap"></span>
      </a>
      <a class="lf-header__icon lf-header__icon--cart" href="{{ cart.url }}" aria-label="কার্ট">
        <span class="lf-header__icon-wrap">{% render 'icon', icon: 'cart' %}</span>
        <span class="lf-header__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- comment -%}
    A small set of real popular products, rendered server-side straight from the
    live catalog, used only for the focused-but-empty suggestion state. Nothing
    here is hardcoded and no data is faked. Hidden from layout (script island); ignored entirely on mobile where the desktop field is display:none.
  {%- endcomment -%}
  <div class="lf-menu-overlay" data-menu-close></div>
<aside class="lf-menu-drawer" data-menu-drawer aria-hidden="true" aria-label="মেনু">
  <div class="lf-menu-drawer__head">
    <h3>মেনু</h3>
    <button class="lf-header__icon" data-menu-close aria-label="মেনু বন্ধ করুন">{% render 'icon', icon: 'close' %}</button>
  </div>
  <nav class="lf-menu-drawer__nav" aria-label="মোবাইল ন্যাভিগেশন">
    <ul role="list">
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="{{ routes.collections_url }}/smart-gadgets">স্মার্ট গ্যাজেট</a></li>
        <li><a href="{{ routes.collections_url }}/gaming">গেমিং</a></li>
        <li><a href="{{ routes.collections_url }}/fashion">ফ্যাশন</a></li>
        <li><a href="{{ routes.collections_url }}/decorating">ডেকোরেশন</a></li>
        <li><a href="{{ routes.collections_url }}/best-sellers">বেস্ট সেলার</a></li>
        <li><a href="{{ routes.collections_url }}/new-arrivals">নতুন আইটেম</a></li>
        <li><a href="{{ routes.collections_url }}/special-offers">স্পেশাল অফার</a></li>
        <li><a href="{{ routes.root_url }}pages/contact">যোগাযোগ</a></li>
      {%- endif -%}
    </ul>
  </nav>
</aside>
</header>