<section class="cart-page"><div class="cart-page__intro"><span class="eyebrow">আপনার HaatRush কার্ট</span><h1>আপনার কার্ট</h1><a class="text-link" href="{{ routes.all_products_collection_url }}">কেনাকাটা চালিয়ে যান <span>↗</span></a></div>{% if cart.item_count == 0 %}<div class="cart-page__empty"><span>◇</span><h2>আপনার কার্ট খালি</h2><p>আপনার প্রতিদিনের রুটিনের জন্য সেরা পণ্যটি খুঁজে নিন।</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">পণ্য দেখুন</a></div>{% else %}<div class="cart-page__layout"><div class="cart-page__items"><div class="shipping-progress"><span>৳৯৯৯ বা তার বেশি অর্ডারে <strong>ফ্রি ডেলিভারি</strong></span><div><i style="width:{{ cart.total_price | divided_by: 99900.0 | at_most: 100 }}%"></i></div><small>আরও পণ্য যোগ করুন এবং ফ্রি ডেলিভারি পান।</small></div>{% for item in cart.items %}<div class="cart-page-item"><div class="cart-page-item__image">{% if item.image %}{{ item.image | image_url: width: 360 | image_tag }}{% endif %}</div><div class="cart-page-item__details"><span class="eyebrow">{{ item.product.vendor | default: 'HaatRush' }}</span><h2>{{ item.product.title }}</h2><p>{{ item.final_line_price | money }}</p><div class="quantity-control"><button data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}">−</button><span>{{ item.quantity }}</span><button data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}">＋</button></div><a href="{{ item.url_to_remove }}" data-remove-item>Remove</a></div></div>{% endfor %}</div><aside class="cart-page__summary"><div class="gift-panel"><span class="gift-panel__mark">✦</span><div><strong>বিশেষ উপহার</strong><p>৳৯৯৯ বা তার বেশি কেনাকাটায় একটি বিশেষ উপহার বেছে নিন।</p><div class="gift-choices" data-gift-choices><button type="button" data-gift-choice="Contour cooling wand">কুলিং ওয়ান্ড</button><button type="button" data-gift-choice="Precision facial roller">ফেসিয়াল রোলার</button><button type="button" data-gift-choice="Travel tool set">ট্রাভেল সেট</button></div><small data-gift-status>চেকআউটে একটি উপহার বেছে নিন।</small></div></div><form class="discount-form" data-discount-form><input type="text" name="discount" placeholder="ডিসকাউন্ট কোড" aria-label="Discount code"><button type="submit">প্রয়োগ করুন</button></form><p class="cart-note" data-discount-note aria-live="polite"></p><div class="drawer-total"><span>সাবটোটাল</span><strong>{{ cart.total_price | money }}</strong></div><a class="button button--accent button--full" href="{{ routes.checkout_url }}">চেকআউট <span>→</span></a><p class="payment-note">চেকআউটে শিপিং ও ট্যাক্স যোগ হবে<br>bKash · Nagad · Rocket · Cash on Delivery</p></aside></div><div class="cart-page__recommendations"><span class="eyebrow">আপনার পছন্দ হতে পারে</span><div><a href="{{ routes.all_products_collection_url }}">ফেসিয়াল টুলস</a><a href="{{ routes.all_products_collection_url }}">বিউটি ডিভাইস</a><a href="{{ routes.all_products_collection_url }}">গিফট সেট</a></div></div>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[],"presets":[{"name":"Main cart"}]}{% endschema %}