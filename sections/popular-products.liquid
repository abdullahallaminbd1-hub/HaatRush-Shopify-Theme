{%- assign popular_collection = collections[section.settings.collection] -%}
{%- if popular_collection != blank and popular_collection.products_count > 0 -%}
<section class="popular-products" style="padding: 40px 0;">
  <div class="container">
    <div class="section-title">
      <span>⭐ {{ section.settings.title }}</span>
      {%- if section.settings.view_all_url != blank -%}
        <a href="{{ section.settings.view_all_url }}">সব পণ্য দেখুন →</a>
      {%- endif -%}
    </div>

    <div class="product-grid" style="margin-top: 24px;">
      {%- for product in popular_collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product, show_badge: true %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "⭐ জনপ্রিয় পণ্য",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "শিরোনাম",
      "default": "জনপ্রিয় পণ্য"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "কালেকশন নির্বাচন করুন"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "কতটি পণ্য দেখাবেন",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "সব দেখুন লিংক"
    }
  ],
  "presets": [
    {
      "name": "⭐ জনপ্রিয় পণ্য"
    }
  ]
}
{% endschema %}
