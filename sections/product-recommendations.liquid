{%- comment -%}
  HaatRush "You may also like" recommendations.

  Shopify only fills the `recommendations` object when a section is rendered
  through /recommendations/products, so this section keeps that request behind
  `recommendations.performed` (no Liquid error on the first paint) and
  product-recommendations.js asks for it once the grid scrolls into view.
  Until that answer arrives the grid shows a curated selection, so the block is
  never empty.
{%- endcomment -%}
{{ 'product.css' | asset_url | stylesheet_tag }}
{%- assign rec_limit = section.settings.limit | default: 4 -%}
{%- assign rec_scan = rec_limit | plus: 1 -%}
<section class="lf-products lf-products--{{ section.settings.tone }} lf-products--boxed"
         data-recommendations
         data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ rec_limit }}&intent={{ section.settings.intent }}">
  <div class="page-width">
    <div class="lf-section-head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="lf-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="lf-section-title">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="lf-product-grid lf-product-grid--{{ section.settings.columns }}" data-recommendations-grid>
      {%- if recommendations.performed -%}
        {%- for item in recommendations.products limit: rec_limit -%}
          {%- render 'product-card', product: item, show_note: true -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign rec_fallback = section.settings.fallback_collection.products -%}
        {%- unless rec_fallback -%}{%- assign rec_fallback = collections.all.products -%}{%- endunless -%}
        {%- assign rec_shown = 0 -%}
        {%- for item in rec_fallback limit: rec_scan -%}
          {%- if item.id != product.id and rec_shown < rec_limit -%}
            {%- render 'product-card', product: item, show_note: true -%}
            {%- assign rec_shown = rec_shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.view_all_label != blank -%}
      <div class="lf-products__footer">
        <a class="lf-btn-outline" href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label | escape }} <span aria-hidden="true">&#8594;</span></a>
      </div>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Kicker", "default": "আপনার জন্য আরও"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "এগুলোও আপনার পছন্দ হতে পারে"},
    {"type": "collection", "id": "fallback_collection", "label": "Fallback collection", "info": "Shown until Shopify answers with real recommendations. Defaults to all products."},
    {"type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 8, "step": 1, "default": 4},
    {"type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 4},
    {"type": "select", "id": "intent", "label": "Recommendation type", "options": [
      {"value": "related", "label": "Related"},
      {"value": "complementary", "label": "Complementary"}
    ], "default": "related"},
    {"type": "select", "id": "tone", "label": "Background tone", "options": [
      {"value": "plain", "label": "White"},
      {"value": "ivory", "label": "Ivory"},
      {"value": "blue", "label": "Blue"}
    ], "default": "plain"},
    {"type": "text", "id": "view_all_label", "label": "View all label", "default": "সব পণ্য দেখুন"},
    {"type": "url", "id": "view_all_link", "label": "View all link"}
  ],
  "presets": [
    {"name": "Product recommendations"}
  ]
}
{% endschema %}
