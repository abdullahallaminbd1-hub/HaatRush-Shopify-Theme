{%- comment -%}
  Collection Grid – self-contained collection page with inline filter sidebar + product grid.
  Paginated by section.settings.products_per_page
{%- endcomment -%}

<section class="collection-page">
  <div class="container">

    <!-- Breadcrumb -->
    <nav class="collection-page__breadcrumb" aria-label="ব্রেডক্রাম্ব">
      <a href="{{ routes.root_url }}">হোম</a>
      <span class="collection-page__breadcrumb-sep">/</span>
      <a href="{{ routes.collections_url }}">কালেকশন</a>
      <span class="collection-page__breadcrumb-sep">/</span>
      <span class="collection-page__breadcrumb-current">{{ collection.title }}</span>
    </nav>

    <!-- Page Header -->
    <div class="collection-page__header">
      <h1 class="collection-page__title">{{ collection.title | default: 'সব ইলেকট্রনিক্স পণ্য' }}</h1>
      {%- if collection.description != blank -%}
        <p class="collection-page__description">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    <!-- Mobile Filter Toggle -->
    <button class="collection-page__filter-toggle" id="collPageFilterToggle" aria-label="ফিল্টার খুলুন">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M2 4h16M5 10h10M8 16h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      ফিল্টার করুন
    </button>

    <!-- Filter Overlay (mobile) -->
    <div class="collection-page__overlay" id="collPageOverlay"></div>

    <div class="collection-page__layout">

      <!-- ===== INLINE SIDEBAR FILTER ===== -->
      <aside class="collection-page__sidebar" id="collPageSidebar">
        <div class="collection-page__sidebar-header">
          <h3 class="collection-page__sidebar-title">ফিল্টার করুন</h3>
          <button class="collection-page__sidebar-reset" type="button" onclick="resetCollFilters()">সব রিসেট</button>
          <button class="collection-page__sidebar-close" id="collPageFilterClose" aria-label="বন্ধ করুন">&times;</button>
        </div>

        <form class="collection-page__filter-form" id="collFilterForm">
          <!-- মূল্য সীমা -->
          <div class="collection-page__filter-group">
            <h4 class="collection-page__filter-group-title">মূল্য সীমা</h4>
            <div class="collection-page__price-range">
              <div class="collection-page__price-field">
                <label for="coll-price-min">সর্বনিম্ন</label>
                <div class="collection-page__price-input-wrap">
                  <span class="collection-page__currency">৳</span>
                  <input type="number" id="coll-price-min" name="filter.v.price.gte" min="0" max="50000" value="0" placeholder="0">
                </div>
              </div>
              <span class="collection-page__price-sep">—</span>
              <div class="collection-page__price-field">
                <label for="coll-price-max">সর্বোচ্চ</label>
                <div class="collection-page__price-input-wrap">
                  <span class="collection-page__currency">৳</span>
                  <input type="number" id="coll-price-max" name="filter.v.price.lte" min="0" max="50000" value="50000" placeholder="50000">
                </div>
              </div>
            </div>
          </div>

          <!-- পণ্যের ধরন -->
          <div class="collection-page__filter-group">
            <h4 class="collection-page__filter-group-title">পণ্যের ধরন</h4>
            <div class="collection-page__filter-checks">
              {%- if collection.all_tags.size > 0 -%}
                {%- for tag in collection.all_tags -%}
                  <label class="collection-page__filter-check">
                    <input type="checkbox" name="filter.tag" value="{{ tag | handleize }}" {%- if current_tags contains tag %} checked{%- endif -%}>
                    <span>{{ tag }}</span>
                  </label>
                {%- endfor -%}
              {%- else -%}
                <p class="collection-page__filter-empty">কোনো ট্যাগ পাওয়া যায়নি</p>
              {%- endif -%}
            </div>
          </div>

          <!-- উপলব্ধতা -->
          <div class="collection-page__filter-group">
            <h4 class="collection-page__filter-group-title">উপলব্ধতা</h4>
            <div class="collection-page__filter-checks">
              <label class="collection-page__filter-check">
                <input type="checkbox" name="filter.v.availability" value="1" checked>
                <span>স্টকে আছে</span>
              </label>
              <label class="collection-page__filter-check">
                <input type="checkbox" name="filter.v.availability" value="0">
                <span>স্টকে নেই</span>
              </label>
            </div>
          </div>

          <button type="submit" class="collection-page__filter-apply btn-primary">ফিল্টার প্রয়োগ করুন</button>
        </form>
      </aside>

      <!-- ===== MAIN GRID ===== -->
      <div class="collection-page__main">

        <!-- Toolbar: count + sort -->
        <div class="collection-page__toolbar">
          <p class="collection-page__count">
            মোট <strong>{{ collection.products_count }}</strong> টি পণ্য পাওয়া গেছে
          </p>
          <div class="collection-page__sort">
            <label for="sort-select">সাজান:</label>
            <select id="sort-select" onchange="window.location.href = this.value;">
              {%- assign sort_options = 'manual|best-selling|title-ascending|title-descending|price-ascending|price-descending|created-ascending|created-descending' | split: '|' -%}
              {%- assign sort_labels = 'ডিফল্ট|সবচেয়ে বিক্রিত|নাম (ক-হ)|নাম (হ-ক)|মূল্য (কম থেকে বেশি)|মূল্য (বেশি থেকে কম)|নতুন আগে|পুরাতন আগে' | split: '|' -%}
              {%- for i in (0..7) -%}
                <option
                  value="{{ collection.url }}?sort_by={{ sort_options[i] }}"
                  {%- if collection.sort_by == sort_options[i] %} selected{%- endif -%}
                >
                  {{ sort_labels[i] }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        </div>

        <!-- Product Grid -->
        {%- paginate collection.products by section.settings.products_per_page -%}
          <div class="product-grid collection-page__grid">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product, show_badge: true %}
            {%- else -%}
              <p class="collection-page__no-products">কোনো পণ্য পাওয়া যায়নি।</p>
            {%- endfor -%}
          </div>

          <!-- Pagination -->
          {%- if paginate.pages > 1 -%}
            <nav class="collection-page__pagination" aria-label="পেজিনেশন">
              <ul class="collection-page__pagination-list">
                {%- if paginate.previous -%}
                  <li>
                    <a href="{{ paginate.previous.url }}" class="collection-page__pagination-link" aria-label="আগের পৃষ্ঠা">&laquo; আগের</a>
                  </li>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <li>
                      <a href="{{ part.url }}" class="collection-page__pagination-link">{{ part.title }}</a>
                    </li>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <li>
                        <span class="collection-page__pagination-link is-current" aria-current="page">{{ part.title }}</span>
                      </li>
                    {%- else -%}
                      <li>
                        <span class="collection-page__pagination-link">{{ part.title }}</span>
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if paginate.next -%}
                  <li>
                    <a href="{{ paginate.next.url }}" class="collection-page__pagination-link" aria-label="পরের পৃষ্ঠা">পরের &raquo;</a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endpaginate -%}

      </div><!-- /.collection-page__main -->
    </div><!-- /.collection-page__layout -->
  </div>
</section>

<style>
  .collection-page {
    padding: 24px 0 60px;
  }

  /* Breadcrumb */
  .collection-page__breadcrumb {
    font-size: 13px;
    color: #888;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .collection-page__breadcrumb a {
    color: #666;
    text-decoration: none;
  }
  .collection-page__breadcrumb a:hover {
    color: var(--color-primary, #f60);
    text-decoration: underline;
  }
  .collection-page__breadcrumb-current {
    color: #1a1a2e;
    font-weight: 600;
  }

  /* Header */
  .collection-page__header {
    margin-bottom: 24px;
  }
  .collection-page__title {
    font-size: 28px;
    font-weight: 800;
    color: #1a1a2e;
    margin: 0 0 8px;
  }
  .collection-page__description {
    font-size: 15px;
    color: #666;
    margin: 0;
    max-width: 700px;
  }

  /* Layout */
  .collection-page__layout {
    display: flex;
    gap: 30px;
    align-items: flex-start;
  }

  /* Mobile filter toggle */
  .collection-page__filter-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--color-primary, #f60);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 16px;
  }

  .collection-page__overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 999;
  }

  /* Sidebar */
  .collection-page__sidebar {
    width: 280px;
    flex-shrink: 0;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 20px;
    position: sticky;
    top: 100px;
  }
  .collection-page__sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .collection-page__sidebar-title {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0;
  }
  .collection-page__sidebar-reset {
    background: none;
    border: none;
    color: var(--color-primary, #f60);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
  }
  .collection-page__sidebar-close {
    display: none;
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: #666;
    padding: 0;
  }

  /* Filter groups */
  .collection-page__filter-group {
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e5e7eb;
  }
  .collection-page__filter-group:last-of-type {
    border-bottom: none;
  }
  .collection-page__filter-group-title {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 12px;
  }
  .collection-page__price-range {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  .collection-page__price-field {
    flex: 1;
  }
  .collection-page__price-field label {
    display: block;
    font-size: 12px;
    color: #666;
    margin-bottom: 4px;
  }
  .collection-page__price-input-wrap {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    overflow: hidden;
  }
  .collection-page__currency {
    padding: 8px;
    background: #f3f4f6;
    font-size: 14px;
    color: #666;
    border-right: 1px solid #d1d5db;
  }
  .collection-page__price-input-wrap input {
    border: none;
    padding: 8px;
    width: 100%;
    font-size: 14px;
    outline: none;
  }
  .collection-page__price-sep {
    font-size: 16px;
    color: #999;
    padding-bottom: 8px;
  }
  .collection-page__filter-checks {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .collection-page__filter-check {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 14px;
    color: #333;
  }
  .collection-page__filter-check input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--color-primary, #f60);
    cursor: pointer;
  }
  .collection-page__filter-empty {
    font-size: 13px;
    color: #999;
    margin: 0;
  }
  .collection-page__filter-apply {
    width: 100%;
    padding: 12px;
    background: var(--color-primary, #f60);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 8px;
    transition: background 0.2s;
  }
  .collection-page__filter-apply:hover {
    background: #e55a00;
  }

  /* Main content */
  .collection-page__main {
    flex: 1;
    min-width: 0;
  }

  /* Toolbar */
  .collection-page__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .collection-page__count {
    font-size: 14px;
    color: #666;
    margin: 0;
  }
  .collection-page__sort {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #666;
  }
  .collection-page__sort select {
    padding: 8px 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
    cursor: pointer;
    background: #fff;
  }

  /* Grid */
  .collection-page__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .collection-page__no-products {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 16px;
    color: #999;
    padding: 60px 20px;
  }

  /* Pagination */
  .collection-page__pagination {
    margin-top: 40px;
    display: flex;
    justify-content: center;
  }
  .collection-page__pagination-list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 6px;
  }
  .collection-page__pagination-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #1a1a2e;
    text-decoration: none;
    transition: all 0.2s;
  }
  .collection-page__pagination-link:hover {
    background: var(--color-primary, #f60);
    color: #fff;
    border-color: var(--color-primary, #f60);
  }
  .collection-page__pagination-link.is-current {
    background: var(--color-primary, #f60);
    color: #fff;
    border-color: var(--color-primary, #f60);
  }

  /* Responsive */
  @media (max-width: 992px) {
    .collection-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .collection-page__filter-toggle {
      display: inline-flex;
    }

    .collection-page__sidebar {
      position: fixed;
      top: 0;
      left: -320px;
      height: 100vh;
      z-index: 1000;
      border-radius: 0;
      overflow-y: auto;
      transition: left 0.3s ease;
      width: 300px;
    }
    .collection-page__sidebar.is-open {
      left: 0;
    }
    .collection-page__sidebar-close {
      display: block;
    }
    .collection-page__overlay.is-active {
      display: block;
    }

    .collection-page__title {
      font-size: 22px;
    }
  }

  @media (max-width: 480px) {
    .collection-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function() {
    var toggle = document.getElementById('collPageFilterToggle');
    var sidebar = document.getElementById('collPageSidebar');
    var overlay = document.getElementById('collPageOverlay');
    var close = document.getElementById('collPageFilterClose');

    function openSidebar() {
      sidebar.classList.add('is-open');
      overlay.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('is-open');
      overlay.classList.remove('is-active');
      document.body.style.overflow = '';
    }

    if (toggle) toggle.addEventListener('click', openSidebar);
    if (close) close.addEventListener('click', closeSidebar);
    if (overlay) overlay.addEventListener('click', closeSidebar);
  })();

  function resetCollFilters() {
    var form = document.getElementById('collFilterForm');
    if (form) {
      form.reset();
      var minInput = document.getElementById('coll-price-min');
      var maxInput = document.getElementById('coll-price-max');
      if (minInput) minInput.value = '0';
      if (maxInput) maxInput.value = '50000';
    }
  }
</script>

<script src="{{ 'filters.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "📦 কালেকশন গ্রিড",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "প্রতি পৃষ্ঠায় পণ্য সংখ্যা",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "📦 কালেকশন গ্রিড"
    }
  ]
}
{% endschema %}
