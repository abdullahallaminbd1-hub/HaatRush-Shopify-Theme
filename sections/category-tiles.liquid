<section class="lf-categories" data-reveal-group>
  <div class="page-width">
    <div class="lf-section-head">
      <span class="lf-eyebrow">{{ section.settings.kicker }}</span>
      <h2 class="lf-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lf-section-subtitle">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="lf-categories__grid">
      {%- for block in section.blocks -%}
        <a class="lf-category-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }} data-reveal>
          <div class="lf-category-card__image">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <span class="lf-category-card__placeholder lf-category-card__placeholder--{{ forloop.index }}">{{ block.settings.title | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <strong class="lf-category-card__name">{{ block.settings.title }}</strong>
          <span class="lf-category-card__link">{{ block.settings.link_label }} <span aria-hidden="true">→</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Category circles",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"Curated for everyday beauty"},
    {"type":"text","id":"heading","label":"Heading","default":"Explore the <span>HaatRush Collection</span>"},
    {"type":"textarea","id":"text","label":"Text","default":"Discover beauty tools, facial rituals and everyday essentials thoughtfully selected for modern routines."}
  ],
  "blocks": [
    {"type":"tile","name":"Category","settings":[
      {"type":"text","id":"title","label":"Title","default":"Beauty Tools"},
      {"type":"text","id":"link_label","label":"Link label","default":"Shop collection"},
      {"type":"url","id":"link","label":"Link"},
      {"type":"image_picker","id":"image","label":"Image"}
    ]}
  ],
  "max_blocks": 12,
  "presets":[{"name":"Category circles","blocks":[
    {"type":"tile","settings":{"title":"Beauty Tools","link_label":"Shop collection"}},
    {"type":"tile","settings":{"title":"Facial Tools","link_label":"Explore facial tools"}},
    {"type":"tile","settings":{"title":"Skincare Tools","link_label":"Discover skincare"}},
    {"type":"tile","settings":{"title":"Beauty Devices","link_label":"Explore devices"}},
    {"type":"tile","settings":{"title":"Hair Tools","link_label":"Shop hair tools"}},
    {"type":"tile","settings":{"title":"New Arrivals","link_label":"Shop new arrivals"}}
  ]}]
}
{% endschema %}