<section class="search-page"><div class="search-page__intro"><span class="eyebrow">Find your next ritual tool</span><h1>Search</h1>{% render 'search-form' %}</div>{% if search.performed %}<div class="search-page__results"><div class="section-heading"><span class="eyebrow">{{ search.results_count }} results</span>{% if search.terms != blank %}<p>Showing results for “{{ search.terms | escape }}”</p>{% endif %}</div>{% if search.results_count > 0 %}<div class="product-grid product-grid--collection">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% else %}<div class="search-empty"><span>◇</span><h2>No tools found</h2><p>Try a broader search or explore the full HaatRush edit.</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">Shop all tools</a></div>{% endif %}</div>{% else %}<div class="search-empty search-empty--initial"><span>✦</span><h2>Search the edit</h2><p>Look for facial tools, beauty devices, hair tools, and everyday accessories.</p></div>{% endif %}</section>
{% schema %}{"name":"Main search","settings":[],"presets":[{"name":"Main search"}]}{% endschema %}