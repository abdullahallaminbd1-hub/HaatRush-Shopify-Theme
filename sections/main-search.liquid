<section class="search-page"><div class="search-page__intro"><span class="eyebrow">{{ 'general.search' | t }}</span><h1>{{ 'general.search' | t }}</h1>{% render 'search-form' %}</div>{% if search.performed %}<div class="search-page__results"><div class="section-heading"><span class="eyebrow">{{ search.results_count }} {{ 'general.results' | t }}</span>{% if search.terms != blank %}<p>{{ 'general.showing_results' | t }} “{{ search.terms | escape }}”</p>{% endif %}</div>{% if search.results_count > 0 %}<div class="product-grid product-grid--collection">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% else %}<div class="search-empty"><span>◇</span><h2>{{ 'general.no_results' | t }}</h2><p>{{ 'general.no_results' | t }}</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">{{ 'general.view_all' | t }}</a></div>{% endif %}</div>{% else %}<div class="search-empty search-empty--initial"><span>✦</span><h2>{{ 'general.search' | t }}</h2><p>{{ 'general.search_placeholder' | t }}</p></div>{% endif %}</section>
{% schema %}{"name":"Main search","settings":[],"presets":[{"name":"Main search"}]}{% endschema %}