{%- comment -%} Product description and Shopify-sourced specifications. {%- endcomment -%}

<section class="product-description" id="productDescription">
  <div class="container">

    <!-- ===== TABS ===== -->
    <div class="product-tabs">
      <div class="product-tabs__nav" role="tablist" aria-label="পণ্যের তথ্য">
        <button class="product-tabs__btn is-active" id="tab-description-button" data-tab="tab-description" role="tab" aria-controls="tab-description" aria-selected="true" type="button">পণ্যের বিবরণ</button>
        <button class="product-tabs__btn" id="tab-specs-button" data-tab="tab-specs" role="tab" aria-controls="tab-specs" aria-selected="false" type="button">স্পেসিফিকেশন</button>
      </div>

      <!-- Tab 1: বিবরণ -->
      <div class="product-tabs__panel is-active" id="tab-description" role="tabpanel" aria-labelledby="tab-description-button" tabindex="0">
        <div class="product-tabs__content">
          {%- if product.description != blank -%}
            <div class="product-tabs__html rte">
              {{ product.description }}
            </div>
          {%- else -%}
            <p class="product-tabs__empty">এই পণ্যের বিস্তারিত বিবরণ শীঘ্রই যোগ করা হবে।</p>
          {%- endif -%}

          <!-- Specification Table (brief) -->
          {%- if product.metafields.custom.specifications != blank -%}
            <h3 class="product-tabs__sub-title" style="margin-top: 24px;">মূল বৈশিষ্ট্য</h3>
            <table class="product-tabs__spec-table">
              <tbody>
                {%- assign specs = product.metafields.custom.specifications.value -%}
                {%- for spec in specs -%}
                  <tr>
                    <td class="product-tabs__spec-label">{{ spec.label }}</td>
                    <td class="product-tabs__spec-value">{{ spec.value }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}

          {%- assign feature_tag_count = 0 -%}
          {%- for tag in product.tags -%}
            {%- if tag contains 'feature:' -%}
              {%- assign feature_tag_count = feature_tag_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if feature_tag_count > 0 -%}
            <h3 class="product-tabs__sub-title" style="margin-top: 24px;">বৈশিষ্ট্য সমূহ</h3>
            <ul class="product-tabs__checklist">
              {%- for tag in product.tags -%}
                {%- if tag contains 'feature:' -%}
                  <li class="product-tabs__check-item">{{ tag | remove: 'feature:' | strip }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      <!-- Tab 2: স্পেসিফিকেশন -->
      <div class="product-tabs__panel" id="tab-specs" role="tabpanel" aria-labelledby="tab-specs-button" tabindex="0">
        <div class="product-tabs__content">
          <h3 class="product-tabs__sub-title">সম্পূর্ণ স্পেসিফিকেশন</h3>
          {%- if product.metafields.custom.full_specifications != blank -%}
            <table class="product-tabs__spec-table">
              <tbody>
                {%- assign full_specs = product.metafields.custom.full_specifications.value -%}
                {%- for spec in full_specs -%}
                  <tr>
                    <td class="product-tabs__spec-label">{{ spec.label }}</td>
                    <td class="product-tabs__spec-value">{{ spec.value }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <table class="product-tabs__spec-table">
              <tbody>
                <tr>
                  <td class="product-tabs__spec-label">পণ্যের ধরন</td>
                  <td class="product-tabs__spec-value">{{ product.type | default: '—' }}</td>
                </tr>
                <tr>
                  <td class="product-tabs__spec-label">ব্র্যান্ড</td>
                  <td class="product-tabs__spec-value">{{ product.vendor | default: '—' }}</td>
                </tr>
                <tr>
                  <td class="product-tabs__spec-label">SKU</td>
                  <td class="product-tabs__spec-value">{{ product.selected_or_first_available_variant.sku | default: '—' }}</td>
                </tr>
                <tr>
                  <td class="product-tabs__spec-label">ওজন</td>
                  <td class="product-tabs__spec-value">
                    {%- if product.selected_or_first_available_variant.weight > 0 -%}
                      {{ product.selected_or_first_available_variant.weight | weight_with_unit }}
                    {%- else -%}
                      —
                    {%- endif -%}
                  </td>
                </tr>
                {%- for tag in product.tags -%}
                  {%- if tag contains 'spec:' -%}
                    {%- assign spec_parts = tag | remove: 'spec:' | split: '|' -%}
                    <tr>
                      <td class="product-tabs__spec-label">{{ spec_parts[0] | strip }}</td>
                      <td class="product-tabs__spec-value">{{ spec_parts[1] | strip | default: '—' }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .product-description {
    padding: 0 0 60px;
  }

  /* Tabs */
  .product-tabs {
    margin-bottom: 40px;
  }
  .product-tabs__nav {
    display: flex;
    border-bottom: 2px solid #e5e7eb;
    gap: 0;
    overflow-x: auto;
  }
  .product-tabs__btn {
    padding: 14px 24px;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 15px;
    font-weight: 600;
    color: #888;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
    margin-bottom: -2px;
  }
  .product-tabs__btn:hover {
    color: #1a1a2e;
  }
  .product-tabs__btn.is-active {
    color: var(--color-primary, #f60);
    border-bottom-color: var(--color-primary, #f60);
  }

  .product-tabs__panel {
    display: none;
    padding: 24px 0;
  }
  .product-tabs__panel.is-active {
    display: block;
  }
  .product-tabs__content {
    max-width: 800px;
  }
  .product-tabs__html {
    font-size: 15px;
    line-height: 1.75;
    color: #333;
  }
  .product-tabs__empty {
    color: #999;
    font-size: 15px;
  }
  .product-tabs__sub-title {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 12px;
  }

  /* Spec Table */
  .product-tabs__spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .product-tabs__spec-table tr {
    border-bottom: 1px solid #f0f0f0;
  }
  .product-tabs__spec-table tr:nth-child(even) {
    background: #fafafa;
  }
  .product-tabs__spec-label {
    padding: 10px 16px;
    font-weight: 600;
    color: #555;
    width: 40%;
    white-space: nowrap;
  }
  .product-tabs__spec-value {
    padding: 10px 16px;
    color: #1a1a2e;
  }

  /* Checklist */
  .product-tabs__checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .product-tabs__check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #333;
  }
  .product-tabs__check-icon {
    font-size: 16px;
    flex-shrink: 0;
  }

  /* Order Form */
  .order-form {
    background: #fff;
    border: 2px solid var(--color-primary, #f60);
    border-radius: 16px;
    overflow: hidden;
    margin-top: 40px;
  }
  .order-form__banner {
    background: var(--color-primary, #f60);
    padding: 16px 24px;
  }
  .order-form__banner-title {
    font-size: 22px;
    font-weight: 800;
    color: #fff;
    margin: 0;
    text-align: center;
  }
  .order-form__body {
    display: flex;
    gap: 32px;
    padding: 28px;
  }

  /* Form Fields */
  .order-form__fields {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .order-form__field label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 6px;
  }
  .order-form__required {
    color: #e53e3e;
  }
  .order-form__field input,
  .order-form__field select,
  .order-form__field textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
    font-family: inherit;
  }
  .order-form__field input:focus,
  .order-form__field select:focus,
  .order-form__field textarea:focus {
    border-color: var(--color-primary, #f60);
    box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1);
  }
  .order-form__row {
    display: flex;
    gap: 12px;
  }
  .order-form__row .order-form__field {
    flex: 1;
  }

  /* Summary */
  .order-form__summary {
    width: 360px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #f9fafb;
    border-radius: 12px;
    padding: 20px;
  }
  .order-form__product-info {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .order-form__product-img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
  }
  .order-form__product-img-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .order-form__product-img-placeholder svg {
    width: 40px;
    height: 40px;
  }
  .order-form__product-title {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .order-form__price-current {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-primary, #f60);
  }
  .order-form__price-compare {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
    margin-left: 8px;
  }

  /* Quantity */
  .order-form__qty {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .order-form__qty label {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a2e;
  }
  .order-form__qty-controls {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    overflow: hidden;
  }
  .order-form__qty-btn {
    width: 36px;
    height: 36px;
    background: #f3f4f6;
    border: none;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a2e;
    transition: background 0.2s;
  }
  .order-form__qty-btn:hover {
    background: #e5e7eb;
  }
  .order-form__qty-controls input {
    width: 48px;
    text-align: center;
    border: none;
    border-left: 1px solid #d1d5db;
    border-right: 1px solid #d1d5db;
    font-size: 15px;
    font-weight: 700;
    padding: 6px 0;
    outline: none;
  }

  /* Delivery radios */
  .order-form__delivery-option label:first-child {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 8px;
    display: block;
  }
  .order-form__delivery-radios {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .order-form__radio {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #333;
    cursor: pointer;
  }
  .order-form__radio input[type="radio"] {
    accent-color: var(--color-primary, #f60);
    width: 16px;
    height: 16px;
  }

  /* Totals */
  .order-form__totals {
    border-top: 1px solid #e5e7eb;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .order-form__totals-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: #555;
  }
  .order-form__totals-total {
    font-size: 18px;
    font-weight: 800;
    color: #1a1a2e;
    padding-top: 8px;
    border-top: 1px solid #e5e7eb;
  }

  /* Confirm button */
  .order-form__confirm {
    width: 100%;
    padding: 14px;
    background: var(--color-primary, #f60);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 17px;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 4px;
  }
  .order-form__confirm:hover {
    background: #e55a00;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .order-form__body {
      flex-direction: column;
      padding: 20px;
    }
    .order-form__summary {
      width: 100%;
    }
    .order-form__row {
      flex-direction: column;
    }
    .product-tabs__btn {
      padding: 12px 16px;
      font-size: 13px;
    }
  }
</style>

<script>
  (function() {
    var section = document.getElementById('productDescription');
    if (!section) return;
    var tabBtns = section.querySelectorAll('.product-tabs__btn');
    var tabPanels = section.querySelectorAll('.product-tabs__panel');

    function activateTab(btn, focus) {
      var targetId = btn.getAttribute('data-tab');
      tabBtns.forEach(function(tab) {
        var active = tab === btn;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
      });
      tabPanels.forEach(function(panel) {
        var active = panel.id === targetId;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
      if (focus) btn.focus();
    }

    tabBtns.forEach(function(btn, index) {
      btn.addEventListener('click', function() {
        activateTab(btn, false);
      });
      btn.addEventListener('keydown', function(event) {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        var direction = event.key === 'ArrowRight' ? 1 : -1;
        var nextIndex = (index + direction + tabBtns.length) % tabBtns.length;
        activateTab(tabBtns[nextIndex], true);
      });
    });

    tabPanels.forEach(function(panel, index) {
      panel.hidden = !panel.classList.contains('is-active');
      tabBtns[index].tabIndex = tabBtns[index].classList.contains('is-active') ? 0 : -1;
    });
  })();
</script>

{% schema %}
{
  "name": "বিবরণ ও স্পেসিফিকেশন",
  "settings": [],
  "presets": [
    {
      "name": "বিবরণ ও স্পেসিফিকেশন"
    }
  ]
}
{% endschema %}
