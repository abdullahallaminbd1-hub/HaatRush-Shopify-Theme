{%- comment -%}
  Product Description Tabs + Embedded Order Form
  Three tabs: পণ্যের বিবরণ | স্পেসিফিকেশন | ডেলিভারি ও রিটার্ন
  Below: order form with fields + summary
{%- endcomment -%}

<section class="product-description" id="productDescription">
  <div class="container">

    <!-- ===== TABS ===== -->
    <div class="product-tabs">
      <div class="product-tabs__nav">
        <button class="product-tabs__btn is-active" data-tab="tab-description" type="button">পণ্যের বিবরণ</button>
        <button class="product-tabs__btn" data-tab="tab-specs" type="button">স্পেসিফিকেশন</button>
        <button class="product-tabs__btn" data-tab="tab-delivery" type="button">ডেলিভারি ও রিটার্ন</button>
      </div>

      <!-- Tab 1: বিবরণ -->
      <div class="product-tabs__panel is-active" id="tab-description">
        <div class="product-tabs__content">
          {%- if product.description != blank -%}
            <div class="product-tabs__html rte">
              {{ product.description }}
            </div>
          {%- else -%}
            <p class="product-tabs__empty">এই পণ্যের বিস্তারিত বিবরণ শীঘ্রই যোগ করা হবে।</p>
          {%- endif -%}

          <!-- Specification Table (brief) -->
          {%- if product.metafields.custom.specifications != blank -%}
            <h3 class="product-tabs__sub-title" style="margin-top: 24px;">মূল বৈশিষ্ট্য</h3>
            <table class="product-tabs__spec-table">
              <tbody>
                {%- assign specs = product.metafields.custom.specifications.value -%}
                {%- for spec in specs -%}
                  <tr>
                    <td class="product-tabs__spec-label">{{ spec.label }}</td>
                    <td class="product-tabs__spec-value">{{ spec.value }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}

          <!-- Feature Checklist -->
          <h3 class="product-tabs__sub-title" style="margin-top: 24px;">বৈশিষ্ট্য সমূহ</h3>
          <ul class="product-tabs__checklist">
            {%- for tag in product.tags -%}
              {%- if tag contains 'feature:' -%}
                <li class="product-tabs__check-item">
                  <span class="product-tabs__check-icon">✅</span>
                  {{ tag | remove: 'feature:' | strip }}
                </li>
              {%- endif -%}
            {%- endfor -%}
            {%- if product.tags.size == 0 -%}
              <li class="product-tabs__check-item"><span class="product-tabs__check-icon">✅</span> উচ্চ মানের পণ্য</li>
              <li class="product-tabs__check-item"><span class="product-tabs__check-icon">✅</span> দ্রুত ডেলিভারি</li>
              <li class="product-tabs__check-item"><span class="product-tabs__check-icon">✅</span> ওয়ারেন্টি সুবিধা</li>
              <li class="product-tabs__check-item"><span class="product-tabs__check-icon">✅</span> ক্যাশ অন ডেলিভারি</li>
            {%- endif -%}
          </ul>
        </div>
      </div>

      <!-- Tab 2: স্পেসিফিকেশন -->
      <div class="product-tabs__panel" id="tab-specs">
        <div class="product-tabs__content">
          <h3 class="product-tabs__sub-title">সম্পূর্ণ স্পেসিফিকেশন</h3>
          {%- if product.metafields.custom.full_specifications != blank -%}
            <table class="product-tabs__spec-table">
              <tbody>
                {%- assign full_specs = product.metafields.custom.full_specifications.value -%}
                {%- for spec in full_specs -%}
                  <tr>
                    <td class="product-tabs__spec-label">{{ spec.label }}</td>
                    <td class="product-tabs__spec-value">{{ spec.value }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <table class="product-tabs__spec-table">
              <tbody>
                <tr>
                  <td class="product-tabs__spec-label">পণ্যের ধরন</td>
                  <td class="product-tabs__spec-value">{{ product.type | default: '—' }}</td>
                </tr>
                <tr>
                  <td class="product-tabs__spec-label">ব্র্যান্ড</td>
                  <td class="product-tabs__spec-value">{{ product.vendor | default: '—' }}</td>
                </tr>
                <tr>
                  <td class="product-tabs__spec-label">SKU</td>
                  <td class="product-tabs__spec-value">{{ product.selected_or_first_available_variant.sku | default: '—' }}</td>
                </tr>
                <tr>
                  <td class="product-tabs__spec-label">ওজন</td>
                  <td class="product-tabs__spec-value">
                    {%- if product.selected_or_first_available_variant.weight > 0 -%}
                      {{ product.selected_or_first_available_variant.weight | weight_with_unit }}
                    {%- else -%}
                      —
                    {%- endif -%}
                  </td>
                </tr>
                {%- for tag in product.tags -%}
                  {%- if tag contains 'spec:' -%}
                    {%- assign spec_parts = tag | remove: 'spec:' | split: '|' -%}
                    <tr>
                      <td class="product-tabs__spec-label">{{ spec_parts[0] | strip }}</td>
                      <td class="product-tabs__spec-value">{{ spec_parts[1] | strip | default: '—' }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>

      <!-- Tab 3: ডেলিভারি ও রিটার্ন -->
      <div class="product-tabs__panel" id="tab-delivery">
        <div class="product-tabs__content">
          <h3 class="product-tabs__sub-title">ডেলিভারি তথ্য</h3>
          <table class="product-tabs__spec-table">
            <tbody>
              <tr>
                <td class="product-tabs__spec-label">ঢাকার ভিতরে</td>
                <td class="product-tabs__spec-value">৳{{ section.settings.delivery_inside_dhaka }}</td>
              </tr>
              <tr>
                <td class="product-tabs__spec-label">ঢাকার বাহিরে</td>
                <td class="product-tabs__spec-value">৳{{ section.settings.delivery_outside_dhaka }}</td>
              </tr>
              <tr>
                <td class="product-tabs__spec-label">ডেলিভারি সময়</td>
                <td class="product-tabs__spec-value">ঢাকায় ১-২ দিন, ঢাকার বাহিরে ২-৫ দিন</td>
              </tr>
              <tr>
                <td class="product-tabs__spec-label">পেমেন্ট</td>
                <td class="product-tabs__spec-value">ক্যাশ অন ডেলিভারি / বিকাশ / নগদ</td>
              </tr>
            </tbody>
          </table>

          <h3 class="product-tabs__sub-title" style="margin-top: 24px;">রিটার্ন পলিসি</h3>
          <ul class="product-tabs__checklist">
            <li class="product-tabs__check-item">
              <span class="product-tabs__check-icon">✅</span>
              পণ্য হাতে পেয়ে চেক করে তারপর টাকা দিন
            </li>
            <li class="product-tabs__check-item">
              <span class="product-tabs__check-icon">✅</span>
              {{ section.settings.return_days }} দিনের মধ্যে রিটার্ন/এক্সচেঞ্জ সুবিধা
            </li>
            <li class="product-tabs__check-item">
              <span class="product-tabs__check-icon">✅</span>
              ত্রুটিপূর্ণ পণ্য সম্পূর্ণ ফেরত বা বদল
            </li>
            <li class="product-tabs__check-item">
              <span class="product-tabs__check-icon">⚠️</span>
              ব্যবহৃত বা ক্ষতিগ্রস্ত পণ্য রিটার্ন গ্রহণযোগ্য নয়
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ===== EMBEDDED ORDER FORM ===== -->
    <div class="order-form" id="orderFormSection">
      <div class="order-form__banner">
        <h2 class="order-form__banner-title">🛒 আপনার অর্ডার করুন</h2>
      </div>

      <div class="order-form__body">
        <!-- Left: Form Fields -->
        <div class="order-form__fields">
          <div class="order-form__field">
            <label for="order-name">আপনার নাম <span class="order-form__required">*</span></label>
            <input type="text" id="order-name" name="name" placeholder="আপনার পুরো নাম লিখুন" required>
          </div>

          <div class="order-form__field">
            <label for="order-phone">মোবাইল নম্বর <span class="order-form__required">*</span></label>
            <input type="tel" id="order-phone" name="phone" placeholder="01XXXXXXXXX" required>
          </div>

          <div class="order-form__row">
            <div class="order-form__field">
              <label for="order-division">বিভাগ <span class="order-form__required">*</span></label>
              <select id="order-division" name="division" required>
                <option value="">বিভাগ নির্বাচন করুন</option>
                <option value="ঢাকা">ঢাকা</option>
                <option value="চট্টগ্রাম">চট্টগ্রাম</option>
                <option value="রাজশাহী">রাজশাহী</option>
                <option value="খুলনা">খুলনা</option>
                <option value="বরিশাল">বরিশাল</option>
                <option value="সিলেট">সিলেট</option>
                <option value="রংপুর">রংপুর</option>
                <option value="ময়মনসিংহ">ময়মনসিংহ</option>
              </select>
            </div>
            <div class="order-form__field">
              <label for="order-district">জেলা <span class="order-form__required">*</span></label>
              <input type="text" id="order-district" name="district" placeholder="জেলার নাম" required>
            </div>
          </div>

          <div class="order-form__field">
            <label for="order-upazila">উপজেলা / থানা</label>
            <input type="text" id="order-upazila" name="upazila" placeholder="উপজেলা বা থানার নাম">
          </div>

          <div class="order-form__field">
            <label for="order-address">সম্পূর্ণ ঠিকানা <span class="order-form__required">*</span></label>
            <textarea id="order-address" name="address" rows="3" placeholder="বাসা নম্বর, রোড, এলাকা ইত্যাদি" required></textarea>
          </div>
        </div>

        <!-- Right: Order Summary -->
        <div class="order-form__summary">
          <div class="order-form__product-info">
            {%- if product.featured_image != blank -%}
              <img
                class="order-form__product-img"
                src="{{ product.featured_image | image_url: width: 200 }}"
                alt="{{ product.title }}"
                width="100"
                height="100"
                loading="lazy"
              >
            {%- else -%}
              <div class="order-form__product-img-placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
            <div class="order-form__product-details">
              <h4 class="order-form__product-title">{{ product.title | default: 'পণ্যের নাম' }}</h4>
              <p class="order-form__product-price">
                <span class="order-form__price-current">৳{{ product.price | money_without_currency | default: '0' }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="order-form__price-compare">৳{{ product.compare_at_price | money_without_currency }}</span>
                {%- endif -%}
              </p>
            </div>
          </div>

          <!-- Quantity -->
          <div class="order-form__qty">
            <label>পরিমাণ:</label>
            <div class="order-form__qty-controls">
              <button type="button" class="order-form__qty-btn" id="qtyMinus">−</button>
              <input type="number" id="orderQty" name="quantity" value="1" min="1" max="10" readonly>
              <button type="button" class="order-form__qty-btn" id="qtyPlus">+</button>
            </div>
          </div>

          <!-- Delivery Option -->
          <div class="order-form__delivery-option">
            <label>ডেলিভারি:</label>
            <div class="order-form__delivery-radios">
              <label class="order-form__radio">
                <input type="radio" name="delivery" value="inside" checked data-cost="{{ section.settings.delivery_inside_dhaka }}">
                <span>ঢাকার ভিতরে — ৳{{ section.settings.delivery_inside_dhaka }}</span>
              </label>
              <label class="order-form__radio">
                <input type="radio" name="delivery" value="outside" data-cost="{{ section.settings.delivery_outside_dhaka }}">
                <span>ঢাকার বাহিরে — ৳{{ section.settings.delivery_outside_dhaka }}</span>
              </label>
            </div>
          </div>

          <!-- Totals -->
          <div class="order-form__totals">
            <div class="order-form__totals-row">
              <span>পণ্যের মূল্য:</span>
              <span id="orderSubtotal">৳{{ product.price | money_without_currency | default: '0' }}</span>
            </div>
            <div class="order-form__totals-row">
              <span>ডেলিভারি চার্জ:</span>
              <span id="orderDelivery">৳{{ section.settings.delivery_inside_dhaka }}</span>
            </div>
            <div class="order-form__totals-row order-form__totals-total">
              <span>সর্বমোট:</span>
              <span id="orderTotal">৳0</span>
            </div>
          </div>

          <button type="button" class="order-form__confirm btn-primary" id="confirmOrderBtn">
            ✅ অর্ডার কনফার্ম করুন
          </button>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .product-description {
    padding: 0 0 60px;
  }

  /* Tabs */
  .product-tabs {
    margin-bottom: 40px;
  }
  .product-tabs__nav {
    display: flex;
    border-bottom: 2px solid #e5e7eb;
    gap: 0;
    overflow-x: auto;
  }
  .product-tabs__btn {
    padding: 14px 24px;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 15px;
    font-weight: 600;
    color: #888;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
    margin-bottom: -2px;
  }
  .product-tabs__btn:hover {
    color: #1a1a2e;
  }
  .product-tabs__btn.is-active {
    color: var(--color-primary, #f60);
    border-bottom-color: var(--color-primary, #f60);
  }

  .product-tabs__panel {
    display: none;
    padding: 24px 0;
  }
  .product-tabs__panel.is-active {
    display: block;
  }
  .product-tabs__content {
    max-width: 800px;
  }
  .product-tabs__html {
    font-size: 15px;
    line-height: 1.75;
    color: #333;
  }
  .product-tabs__empty {
    color: #999;
    font-size: 15px;
  }
  .product-tabs__sub-title {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 12px;
  }

  /* Spec Table */
  .product-tabs__spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .product-tabs__spec-table tr {
    border-bottom: 1px solid #f0f0f0;
  }
  .product-tabs__spec-table tr:nth-child(even) {
    background: #fafafa;
  }
  .product-tabs__spec-label {
    padding: 10px 16px;
    font-weight: 600;
    color: #555;
    width: 40%;
    white-space: nowrap;
  }
  .product-tabs__spec-value {
    padding: 10px 16px;
    color: #1a1a2e;
  }

  /* Checklist */
  .product-tabs__checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .product-tabs__check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #333;
  }
  .product-tabs__check-icon {
    font-size: 16px;
    flex-shrink: 0;
  }

  /* Order Form */
  .order-form {
    background: #fff;
    border: 2px solid var(--color-primary, #f60);
    border-radius: 16px;
    overflow: hidden;
    margin-top: 40px;
  }
  .order-form__banner {
    background: var(--color-primary, #f60);
    padding: 16px 24px;
  }
  .order-form__banner-title {
    font-size: 22px;
    font-weight: 800;
    color: #fff;
    margin: 0;
    text-align: center;
  }
  .order-form__body {
    display: flex;
    gap: 32px;
    padding: 28px;
  }

  /* Form Fields */
  .order-form__fields {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .order-form__field label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 6px;
  }
  .order-form__required {
    color: #e53e3e;
  }
  .order-form__field input,
  .order-form__field select,
  .order-form__field textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
    font-family: inherit;
  }
  .order-form__field input:focus,
  .order-form__field select:focus,
  .order-form__field textarea:focus {
    border-color: var(--color-primary, #f60);
    box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1);
  }
  .order-form__row {
    display: flex;
    gap: 12px;
  }
  .order-form__row .order-form__field {
    flex: 1;
  }

  /* Summary */
  .order-form__summary {
    width: 360px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #f9fafb;
    border-radius: 12px;
    padding: 20px;
  }
  .order-form__product-info {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .order-form__product-img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
  }
  .order-form__product-img-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .order-form__product-img-placeholder svg {
    width: 40px;
    height: 40px;
  }
  .order-form__product-title {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .order-form__price-current {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-primary, #f60);
  }
  .order-form__price-compare {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
    margin-left: 8px;
  }

  /* Quantity */
  .order-form__qty {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .order-form__qty label {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a2e;
  }
  .order-form__qty-controls {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    overflow: hidden;
  }
  .order-form__qty-btn {
    width: 36px;
    height: 36px;
    background: #f3f4f6;
    border: none;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a2e;
    transition: background 0.2s;
  }
  .order-form__qty-btn:hover {
    background: #e5e7eb;
  }
  .order-form__qty-controls input {
    width: 48px;
    text-align: center;
    border: none;
    border-left: 1px solid #d1d5db;
    border-right: 1px solid #d1d5db;
    font-size: 15px;
    font-weight: 700;
    padding: 6px 0;
    outline: none;
  }

  /* Delivery radios */
  .order-form__delivery-option label:first-child {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 8px;
    display: block;
  }
  .order-form__delivery-radios {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .order-form__radio {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #333;
    cursor: pointer;
  }
  .order-form__radio input[type="radio"] {
    accent-color: var(--color-primary, #f60);
    width: 16px;
    height: 16px;
  }

  /* Totals */
  .order-form__totals {
    border-top: 1px solid #e5e7eb;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .order-form__totals-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: #555;
  }
  .order-form__totals-total {
    font-size: 18px;
    font-weight: 800;
    color: #1a1a2e;
    padding-top: 8px;
    border-top: 1px solid #e5e7eb;
  }

  /* Confirm button */
  .order-form__confirm {
    width: 100%;
    padding: 14px;
    background: var(--color-primary, #f60);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 17px;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 4px;
  }
  .order-form__confirm:hover {
    background: #e55a00;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .order-form__body {
      flex-direction: column;
      padding: 20px;
    }
    .order-form__summary {
      width: 100%;
    }
    .order-form__row {
      flex-direction: column;
    }
    .product-tabs__btn {
      padding: 12px 16px;
      font-size: 13px;
    }
  }
</style>

<script>
  (function() {
    /* Tab switching */
    var tabBtns = document.querySelectorAll('.product-tabs__btn');
    var tabPanels = document.querySelectorAll('.product-tabs__panel');

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        tabBtns.forEach(function(b) { b.classList.remove('is-active'); });
        tabPanels.forEach(function(p) { p.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var target = document.getElementById(btn.getAttribute('data-tab'));
        if (target) target.classList.add('is-active');
      });
    });

    /* Quantity controls */
    var qtyInput = document.getElementById('orderQty');
    var minusBtn = document.getElementById('qtyMinus');
    var plusBtn = document.getElementById('qtyPlus');

    if (minusBtn) {
      minusBtn.addEventListener('click', function() {
        var val = parseInt(qtyInput.value) || 1;
        if (val > 1) { qtyInput.value = val - 1; updateOrderTotal(); }
      });
    }
    if (plusBtn) {
      plusBtn.addEventListener('click', function() {
        var val = parseInt(qtyInput.value) || 1;
        if (val < 10) { qtyInput.value = val + 1; updateOrderTotal(); }
      });
    }

    /* Delivery radio change */
    var deliveryRadios = document.querySelectorAll('input[name="delivery"]');
    deliveryRadios.forEach(function(radio) {
      radio.addEventListener('change', updateOrderTotal);
    });

    /* Calculate total */
    function updateOrderTotal() {
      var productPrice = {{ product.price | default: 0 }} / 100;
      var qty = parseInt(qtyInput.value) || 1;
      var checkedRadio = document.querySelector('input[name="delivery"]:checked');
      var deliveryCost = checkedRadio ? parseInt(checkedRadio.getAttribute('data-cost')) || 0 : 0;
      var subtotal = productPrice * qty;
      var total = subtotal + deliveryCost;

      var subtotalEl = document.getElementById('orderSubtotal');
      var deliveryEl = document.getElementById('orderDelivery');
      var totalEl = document.getElementById('orderTotal');

      if (subtotalEl) subtotalEl.textContent = '৳' + subtotal.toLocaleString('bn-BD');
      if (deliveryEl) deliveryEl.textContent = '৳' + deliveryCost.toLocaleString('bn-BD');
      if (totalEl) totalEl.textContent = '৳' + total.toLocaleString('bn-BD');
    }

    /* Init */
    updateOrderTotal();

    /* Confirm order */
    var confirmBtn = document.getElementById('confirmOrderBtn');
    if (confirmBtn) {
      confirmBtn.addEventListener('click', function() {
        var name = document.getElementById('order-name').value.trim();
        var phone = document.getElementById('order-phone').value.trim();
        var division = document.getElementById('order-division').value;
        var district = document.getElementById('order-district').value.trim();
        var address = document.getElementById('order-address').value.trim();

        if (!name || !phone || !division || !district || !address) {
          alert('অনুগ্রহ করে সকল প্রয়োজনীয় তথ্য পূরণ করুন।');
          return;
        }
        if (!/^01[3-9]\d{8}$/.test(phone)) {
          alert('সঠিক মোবাইল নম্বর দিন (01XXXXXXXXX)');
          return;
        }

        confirmBtn.disabled = true;
        confirmBtn.textContent = '⏳ অর্ডার প্রসেস হচ্ছে...';

        /* In production, submit via AJAX to a custom endpoint or Shopify cart */
        setTimeout(function() {
          alert('আপনার অর্ডার সফলভাবে নেওয়া হয়েছে! আমরা শীঘ্রই আপনার সাথে যোগাযোগ করবো।');
          confirmBtn.disabled = false;
          confirmBtn.textContent = '✅ অর্ডার কনফার্ম করুন';
        }, 1500);
      });
    }
  })();
</script>

