{%- unless section.settings.enable_trust -%}
  {%- assign show_trust = false -%}{%- endunless -%}

  {%- if show_trust -%}
    <section class="trust-section page-width" data-trust-section>
      <div class="trust-section__grid grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
          {%- when 'review' -%}
            <div class="trust-item">
              <div class="trust-item__rating">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    <span class="trust-item__star icon-star filled"></span>
                  {%- else -%}
                    <span class="trust-item__star icon-star empty"></span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <div class="trust-item__author">{{ block.settings.author }}</div>
              <p class="trust-item__text">{{ block.settings.review_text }}</p>
            </div>
          {%- when 'badge' -%}
            <div class="trust-item trust-item--badge">
              <span class="trust-item__badge">{{ block.settings.badge_text }}</span>
              <p class="trust-item__badge-desc">{{ block.settings.badge_desc }}</p>
            </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

{% schema %}
{
  "name": "Trust Section",
  "class": "trust-section",
  "settings": [
    {
      "type": "header",
      "content": "Trust section settings"
    },
    {
      "type": "checkbox",
      "id": "enable_trust",
      "default": false
    },
    {
      "type": "header",
      "content": "Blocks"
    },
    {
      "type": "select",
      "id": "block_type",
      "options": [
        {
          "value": "review",
          "label": "Review"
        },
        {
          "value": "badge",
          "label": "Badge"
        }
      ],
      "default": "review"
    },
    {
      "type": "header",
      "content": "Review settings"
    },
    {
      "type": "number",
      "id": "rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "author",
      "default": "Customer"
    },
    {
      "type": "richtext",
      "id": "review_text",
      "default": "Great product, fast delivery!"
    },
    {
      "type": "header",
      "content": "Badge settings"
    },
    {
      "type": "text",
      "id": "badge_text",
      "default": "Trustworthy"
    },
    {
      "type": "richtext",
      "id": "badge_desc",
      "default": "Customers love our service"
    }
  ],
  "presets": [
    {
      "name": "Default Review",
      "settings": [
        {
          "type": "select",
          "id": "block_type",
          "default": "review"
        },
        {
          "type": "number",
          "id": "rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "author",
          "default": "Customer"
        },
        {
          "type": "richtext",
          "id": "review_text",
          "default": "Great product, fast delivery!"
        }
      ]
    },
    {
      "name": "Default Badge",
      "settings": [
        {
          "type": "select",
          "id": "block_type",
          "default": "badge"
        },
        {
          "type": "text",
          "id": "badge_text",
          "default": "Trustworthy"
        },
        {
          "type": "richtext",
          "id": "badge_desc",
          "default": "Customers love our service"
        }
      ]
    }
  ]
}
{% endschema %}
</section>