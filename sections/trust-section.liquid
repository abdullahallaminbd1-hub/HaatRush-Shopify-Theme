<section class="lf-confidence" data-reveal-group>
  <div class="page-width">
    <div class="lf-confidence__container">
      <div class="lf-confidence__left" data-reveal>
        <div class="lf-confidence__image">
          {%- if section.settings.image -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
          {%- else -%}
            <div class="lf-confidence__placeholder"></div>
          {%- endif -%}
        </div>
        <div class="lf-confidence__returns">
          <span class="lf-confidence__returns-icon">{% render 'icon', icon: 'return' %}</span>
          <div>
            <h4>৭ দিনের রিটার্ন পলিসি</h4>
            <p>নিশ্চINCTে কেনাকাটা করুন। যোগ্য পণ্যের ক্ষেত্রে আমাদের রিটার্ন পলিসি অনুযায়ী রিটার্ন গ্রহণ করা হয়।</p>
          </div>
        </div>
      </div>
      <div class="lf-confidence__right" data-reveal>
        <span class="lf-eyebrow">{{ section.settings.kicker }}</span>
        <h2 class="lf-section-title">{{ section.settings.heading }}</h2>
        <p class="lf-confidence__intro">{{ section.settings.text }}</p>
        <div class="lf-confidence__list">
          {%- for block in section.blocks -%}
            <div class="lf-confidence__item" {{ block.shopify_attributes }}>
              <span class="lf-confidence__icon">{{ block.settings.icon }}</span>
              <div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>
            </div>
          {%- endfor -%}
        </div>
        <div class="lf-newsletter-box">
          <span class="lf-newsletter-box__eyebrow">{{ section.settings.newsletter_kicker }}</span>
          <h3>{{ section.settings.newsletter_heading }}</h3>
          <p>Sign up for product updates, curated finds and selected offers.</p>
          {% form 'customer', class: 'lf-newsletter-form' %}
            {%- if form.posted_successfully? -%}<p class="lf-newsletter-form__success">Thanks for subscribing.</p>{%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="Enter your email address" aria-label="Email address" required>
            <button class="button button--accent" type="submit">সাবস্ক্রাইব করুন</button>
          {% endform %}
          <small>সাবস্ক্রাইব করে আপনি মার্কেটিং ইমেইল পেতে সম্মত হচ্ছেন। যেকোনো সময় আনসাবস্ক্রাইব করতে পারবেন।</small>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Trust section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"kicker","label":"Kicker","default":"নিশ্চINCTে কেনাকাটা করুন"},
    {"type":"text","id":"heading","label":"Heading","default":"নিশ্চINCTে <span>কেনাকাটা</span> করুন"},
    {"type":"textarea","id":"text","label":"Text","default":"সেরা পণ্য, দ্রুত ডেলিভারি এবং নিরাপদ পেমেন্ট — HaatRush-এ কেনাকাটা সবসময়ই নিরাপদ।"},
    {"type":"text","id":"newsletter_kicker","label":"Newsletter kicker","default":"HaatRush নিউজলেটারে যোগ দিন"},
    {"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"নতুন পণ্য ও অফার সরাসরি আপনার ইনবক্সে।"}
  ],
  "blocks": [
    {"type":"item","name":"Trust item","settings":[
      {"type":"text","id":"icon","label":"Icon (character)","default":"✓"},
      {"type":"text","id":"title","label":"Title","default":"Thoughtfully Selected"},
      {"type":"textarea","id":"text","label":"Text","default":"Beauty tools and everyday essentials chosen with care."}
    ]}
  ],
  "max_blocks": 6,
  "presets":[{"name":"Trust section","blocks":[
    {"type":"item","settings":{"icon":"✓","title":"সেরা পণ্য বাছাই","text":"যত্ন সহকারে নির্বাচিত বিউটি টুলস এবং দৈনন্দিন প্রয়োজনীয় পণ্য।"}},
    {"type":"item","settings":{"icon":"◇","title":"নিরাপদ চেকআউট","text":"bKash, Nagad, Rocket ও COD-সহ সুরক্ষিত পেমেন্ট অভিজ্ঞতা।"}},
    {"type":"item","settings":{"icon":"→","title":"সারাদেশে ডেলিভারি","text":"নির্দিষ্ট অর্ডারে ফ্রি ডেলিভারি — ঢাকাসহ সারা বাংলাদেশে।"}},
    {"type":"item","settings":{"icon":"✦","title":"কাস্টমার সাপোর্ট","text":"Helpful assistance when you need information about your order."}}
  ]}]
}
{% endschema %}