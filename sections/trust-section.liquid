<section class="lf-confidence" data-reveal-group>
  <div class="page-width">
    <div class="lf-confidence__container">
      <div class="lf-confidence__left" data-reveal>
        <div class="lf-confidence__image">
          {%- if section.settings.image -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
          {%- else -%}
            <div class="lf-confidence__placeholder"></div>
          {%- endif -%}
        </div>
        <div class="lf-confidence__returns">
          <span class="lf-confidence__returns-icon">{% render 'icon', icon: 'return' %}</span>
          <div>
            <h4>{{ 'general.returns' | t }}</h4>
            <p>{{ 'general.returns_note' | t }}</p>
          </div>
        </div>
      </div>
      <div class="lf-confidence__right" data-reveal>
        <span class="lf-eyebrow">{{ section.settings.kicker }}</span>
        <h2 class="lf-section-title">{{ section.settings.heading }}</h2>
        <p class="lf-confidence__intro">{{ section.settings.text }}</p>
        <div class="lf-confidence__list">
          {%- for block in section.blocks -%}
            <div class="lf-confidence__item" {{ block.shopify_attributes }}>
              <span class="lf-confidence__icon">{{ block.settings.icon }}</span>
              <div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>
            </div>
          {%- endfor -%}
        </div>
        <div class="lf-newsletter-box">
          <span class="lf-newsletter-box__eyebrow">{{ section.settings.newsletter_kicker }}</span>
          <h3>{{ section.settings.newsletter_heading }}</h3>
          <p>{{ 'general.newsletter_blurb' | t }}</p>
          {% form 'customer', class: 'lf-newsletter-form' %}
            {%- if form.posted_successfully? -%}<p class="lf-newsletter-form__success">{{ 'general.subscribe_success' | t }}</p>{%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_email' | t }}" aria-label="{{ 'general.email' | t }}" required>
            <button class="button button--accent" type="submit">{{ 'general.subscribe' | t }}</button>
          {% endform %}
          <small>{{ 'general.newsletter_note' | t }}</small>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Trust section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"kicker","label":"Kicker","default":"নিশ্চিন্তে কেনাকাটা করুন"},
    {"type":"text","id":"heading","label":"Heading","default":"আস্থা নিয়ে <span>কেনাকাটা</span>"},
    {"type":"textarea","id":"text","label":"Text","default":"বাছাই করা পণ্য, স্পষ্ট ডেলিভারি তথ্য ও নিরাপদ চেকআউট।"},
    {"type":"text","id":"newsletter_kicker","label":"Newsletter kicker","default":"খবর পেতে থাকুন"},
    {"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"নতুন পণ্য ও অফারের খবর পান ইমেইলে।"}
  ],
  "blocks": [
    {"type":"item","name":"Trust item","settings":[
      {"type":"text","id":"icon","label":"Icon (character)","default":"✓"},
      {"type":"text","id":"title","label":"Title","default":"বাছাই করা পণ্য"},
      {"type":"textarea","id":"text","label":"Text","default":"যত্ন নিয়ে বাছাই করা ইলেকট্রনিক্স ও দৈনন্দিন ডিভাইস।"}
    ]}
  ],
  "max_blocks": 6,
  "presets":[{"name":"Trust section","blocks":[
    {"type":"item","settings":{"icon":"✓","title":"বাছাই করা পণ্য","text":"যত্ন নিয়ে বাছাই করা ইলেকট্রনিক্স ও দৈনন্দিন ডিভাইস।"}},
    {"type":"item","settings":{"icon":"◇","title":"নিরাপদ চেকআউট","text":"Shopify-এর নিরাপদ পেমেন্ট পদ্ধতিতে চেকআউট করুন।"}},
    {"type":"item","settings":{"icon":"→","title":"ডেলিভারি তথ্য","text":"পেমেন্টের আগেই ডেলিভারির বিস্তারিত দেখুন।"}},
    {"type":"item","settings":{"icon":"✦","title":"গ্রাহক সহায়তা","text":"অর্ডার সম্পর্কে তথ্যের প্রয়োজনে সহায়তা।"}}
  ]}]
}
{% endschema %}