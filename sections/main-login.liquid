<section class="auth-page"><div class="auth-card"><span class="eyebrow">{{ 'general.account' | t }}</span><h1>{{ 'general.sign_in' | t }}</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label>{{ 'general.email' | t }}<input type="email" name="customer[email]" autocomplete="email" required></label><label>পাসওয়ার্ড<input type="password" name="customer[password]" autocomplete="current-password" required></label><button class="button button--accent button--full" type="submit">{{ 'general.sign_in' | t }} <span>→</span></button><a class="text-link" href="#recover">পাসওয়ার্ড ভুলে গেছেন?</a>{% endform %}<div class="auth-divider"><span>{{ 'general.account' | t }}</span></div><a class="button button--dark button--full" href="{{ routes.account_register_url }}">নতুন অ্যাকাউন্ট তৈরি করুন <span>→</span></a></div></section>
{% schema %}{"name":"Login page","settings":[],"presets":[{"name":"Login page"}]}{% endschema %}