<section class="auth-page"><div class="auth-card"><span class="eyebrow">HaatRush / account</span><h1>Sign in</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label>Email<input type="email" name="customer[email]" autocomplete="email" required></label><label>Password<input type="password" name="customer[password]" autocomplete="current-password" required></label><button class="button button--accent button--full" type="submit">Sign in <span>→</span></button><a class="text-link" href="#recover">Forgot password?</a>{% endform %}<div class="auth-divider"><span>New to HaatRush?</span></div><a class="button button--dark button--full" href="{{ routes.account_register_url }}">Create an account <span>→</span></a></div></section>
{% schema %}{"name":"Login page","settings":[],"presets":[{"name":"Login page"}]}{% endschema %}