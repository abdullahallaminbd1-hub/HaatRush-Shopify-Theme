{%- unless section.settings.enable_value_strip -%}
  {%- assign show_value = false -%}{%- endunless -%}

  {%- if show_value -%}
    <section class="value-strip page-width" data-value-strip>
      <div class="value-strip__content">
        <div class="value-strip__badge">{{ section.settings.badge_text }}</div>
        <h2 class="value-strip__heading">{{ section.settings.heading }}</h2>
        <p class="value-strip__text">{{ section.settings.text }}</p>
        <div class="value-strip__actions">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
            {%- when 'button' -%}
              <a href="{{ block.settings.url }}" class="button button--accent">{{ block.settings.label }}</a>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

{% schema %}
{
  "name": "Value Strip",
  "class": "value-strip",
  "settings": [
    {
      "type": "header",
      "content": "Value strip settings"
    },
    {
      "type": "text",
      "id": "badge_text",
      "default": "Special Offer"
    },
    {
      "type": "text",
      "id": "heading",
      "default": " grab great deals "
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "Power Bank, Game Console, Smart Watch, Earphone সহ 100+ প্রোডাক্ট। ক্যাশ_online ডেলিভারিতে অর্ডার করুন।"
    },
    {
      "type": "header",
      "content": "Blocks"
    },
    {
      "type": "button",
      "id": "button"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": []
    }
  ]
}
{% endschema %}
</section>