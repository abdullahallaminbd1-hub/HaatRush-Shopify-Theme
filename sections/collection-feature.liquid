<section class="feature-band {{ section.settings.tone }}"><div class="feature-band__copy"><span class="eyebrow">{{ section.settings.kicker }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><a class="text-link" href="{{ section.settings.link }}">Explore collection <span>→</span></a></div><div class="feature-band__art"><div class="art-shape art-shape--large"></div><div class="art-shape art-shape--small"></div><span>{{ section.settings.art_label }}</span></div></section>
{% schema %}{"name":"Collection feature","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"The skin edit"},{"type":"text","id":"heading","label":"Heading","default":"A calmer way to glow."},{"type":"textarea","id":"text","label":"Text","default":"Curated devices and accessories for the moments you make time for."},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"art_label","label":"Art label","default":"HAATRUSH / 01"},{"type":"select","id":"tone","label":"Tone","options":[{"value":"tone-sand","label":"Sand"},{"value":"tone-peach","label":"Peach"}],"default":"tone-sand"}],"presets":[{"name":"Collection feature"}]}{% endschema %}