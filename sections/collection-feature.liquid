<section class="feature-band {{ section.settings.tone }}"><div class="feature-band__copy"><span class="eyebrow">{{ section.settings.kicker }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><a class="text-link" href="{{ section.settings.link }}">{{ 'general.view_all' | t }} <span>→</span></a></div><div class="feature-band__art"><div class="art-shape art-shape--large"></div><div class="art-shape art-shape--small"></div><span>{{ section.settings.art_label }}</span></div></section>
{% schema %}{"name":"Collection feature","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"গ্যাজেটের নতুন বাছাই"},{"type":"text","id":"heading","label":"Heading","default":"শুরু হোক আরও স্মার্টভাবে।"},{"type":"textarea","id":"text","label":"Text","default":"আপনার দৈনন্দিন প্রয়োজনের জন্য বাছাই করা ডিভাইস ও অ্যাক্সেসরিজ।"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"art_label","label":"Art label","default":"হাটরাশ / ০১"},{"type":"select","id":"tone","label":"Tone","options":[{"value":"tone-sand","label":"সাদা-নীল"},{"value":"tone-peach","label":"হালকা নীল"}],"default":"tone-sand"}],"presets":[{"name":"Collection feature"}]}{% endschema %}