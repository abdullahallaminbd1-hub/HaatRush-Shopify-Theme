<section class="trust-badges">
  <div class="container">
    <div class="trust-badges__grid">
      {%- comment -%} Badge 1: Delivery {%- endcomment -%}
      <div class="trust-badges__item">
        <div class="trust-badges__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#5A1EB0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <div class="trust-badges__text">
          <h3 class="trust-badges__title">{{ section.settings.badge_1_title }}</h3>
          <p class="trust-badges__desc">{{ section.settings.badge_1_desc }}</p>
        </div>
      </div>

      {%- comment -%} Badge 2: Cash on Delivery {%- endcomment -%}
      <div class="trust-badges__item">
        <div class="trust-badges__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#5A1EB0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><circle cx="12" cy="15" r="2"/>
          </svg>
        </div>
        <div class="trust-badges__text">
          <h3 class="trust-badges__title">{{ section.settings.badge_2_title }}</h3>
          <p class="trust-badges__desc">{{ section.settings.badge_2_desc }}</p>
        </div>
      </div>

      {%- comment -%} Badge 3: Safe Shopping {%- endcomment -%}
      <div class="trust-badges__item">
        <div class="trust-badges__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#5A1EB0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="trust-badges__text">
          <h3 class="trust-badges__title">{{ section.settings.badge_3_title }}</h3>
          <p class="trust-badges__desc">{{ section.settings.badge_3_desc }}</p>
        </div>
      </div>

      {%- comment -%} Badge 4: Customer Support {%- endcomment -%}
      <div class="trust-badges__item">
        <div class="trust-badges__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#5A1EB0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
          </svg>
        </div>
        <div class="trust-badges__text">
          <h3 class="trust-badges__title">{{ section.settings.badge_4_title }}</h3>
          <p class="trust-badges__desc">{{ section.settings.badge_4_desc }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-badges {
    background: #F8F3FF;
    padding: 40px 0;
  }
  .trust-badges .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .trust-badges__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .trust-badges__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #fff;
    border-radius: 10px;
    padding: 24px 20px;
    transition: box-shadow 0.25s, transform 0.25s;
  }
  .trust-badges__item:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    transform: translateY(-2px);
  }
  .trust-badges__icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: rgba(118, 40, 215, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .trust-badges__text {
    flex: 1;
    min-width: 0;
  }
  .trust-badges__title {
    font-size: 15px;
    font-weight: 700;
    color: #7628D7;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .trust-badges__desc {
    font-size: 12px;
    color: #888;
    margin: 0;
    line-height: 1.5;
  }

  /* Mobile: 2x2 grid */
  @media (max-width: 768px) {
    .trust-badges {
      padding: 32px 0;
    }
    .trust-badges__grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .trust-badges__item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 20px 16px;
    }
  }
  @media (max-width: 400px) {
    .trust-badges__grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .trust-badges__item {
      padding: 16px 12px;
    }
  }
</style>

