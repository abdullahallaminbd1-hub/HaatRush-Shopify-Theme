{%- unless section.settings.enable_reviews -%}
  {%- assign show_reviews = false -%}{%- endunless -%}

  {%- if show_reviews -%}
    <section class="reviews section--padding" data-reviews>
      <div class="page-width">
        <div class="reviews__header">
          <span class="reviews__kicker">{{ section.settings.kicker }}</span>
          <h2 class="reviews__heading">{{ section.settings.heading }}</h2>
        </div>

        <div class="reviews__grid grid">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
            {%- when 'author' -%}
              <div class="reviews__item item">
                <div class="item__avatar">
                  {% if block.settings.avatar %}
                    {{ block.settings.avatar | img_url: '40x40' }}
                  {% else %}
                    <span class="initials">{{ block.settings.name | remove: ' ' | split: '' | join: '' }}</span>
                  {% endif %}
                </div>
                <div class="item__content">
                  <div class="item__header">
                    <span class="item__name">{{ block.settings.name }}</span>
                    <span class="item__date">{{ block.settings.date | date: '%b %d, %Y' }}</span>
                  </div>
                  <div class="item__rating">
                    {%- for i in (1..5) -%}
                      {%- if i <= block.settings.rating -%}
                        <span class="icon-star filled"></span>
                      {%- else -%}
                        <span class="icon-star empty"></span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  <p class="item__text">{{ block.settings.review_text }}</p>
                </div>
              </div>
            {%- when 'summary' -%}
              <div class="reviews__item item">
                <h3 class="item__title">{{ block.settings.title }}</h3>
                <div class="item__rating">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.average_rating -%}
                      <span class="icon-star filled"></span>
                    {%- else -%}
                      <span class="icon-star empty"></span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="item__count">{{ block.settings.total_reviews }} reviews</p>
              </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "class": "reviews",
  "settings": [
    {
      "type": "header",
      "content": "Reviews settings"
    },
    {
      "type": "checkbox",
      "id": "enable_reviews",
      "default": false
    },
    {
      "type": "header",
      "content": "Kicker"
    },
    {
      "type": "text",
      "id": "kicker",
      "default": "Customer Reviews"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "header",
      "content": "Blocks"
    },
    {
      "type": "select",
      "id": "block_type",
      "options": [
        {
          "value": "author",
          "label": "Author Review"
        },
        {
          "value": "summary",
          "label": "Summary"
        }
      ],
      "default": "author"
    },
    {
      "type": "header",
      "content": "Author Review Settings"
    },
    {
      "type": "text",
      "id": "author_name",
      "default": "Customer Name"
    },
    {
      "type": "url",
      "id": "author_avatar",
      "default": ""
    },
    {
      "type": "number",
      "id": "author_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "richtext",
      "id": "author_review_text",
      "default": "Great product, fast delivery!"
    },
    {
      "type": "header",
      "content": "Summary Review Settings"
    },
    {
      "type": "text",
      "id": "summary_title",
      "default": "Top Rated Products"
    },
    {
      "type": "number",
      "id": "summary_average_rating",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "number",
      "id": "summary_total_reviews",
      "default": 128
    }
  ],
  "presets": [
    {
      "name": "Author Review",
      "settings": [
        {
          "type": "select",
          "id": "block_type",
          "default": "author"
        },
        {
          "type": "text",
          "id": "author_name",
          "default": "Customer Name"
        },
        {
          "type": "url",
          "id": "author_avatar",
          "default": ""
        },
        {
          "type": "number",
          "id": "author_rating",
          "default": 5
        },
        {
          "type": "richtext",
          "id": "author_review_text",
          "default": "Great product, fast delivery!"
        }
      ]
    },
    {
      "name": "Summary Review",
      "settings": [
        {
          "type": "select",
          "id": "block_type",
          "default": "summary"
        },
        {
          "type": "text",
          "id": "summary_title",
          "default": "Top Rated Products"
        },
        {
          "type": "number",
          "id": "summary_average_rating",
          "default": 4.5
        },
        {
          "type": "number",
          "id": "summary_total_reviews",
          "default": 128
        }
      ]
    }
  ]
}
{% endschema %}
</section>