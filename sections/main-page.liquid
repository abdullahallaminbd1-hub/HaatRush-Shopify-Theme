{%- comment -%}
  HaatRush Theme - Main Page Section
{%- endcomment -%}

<section class="main-page-section" style="padding: 40px 0;">
  <div class="container">
    {%- render 'breadcrumb' -%}

    <div class="page-header" style="margin-bottom: 24px;">
      <h1 class="page-title" style="font-size: 28px; font-weight: 700; color: var(--color-text);">
        {{ page.title }}
      </h1>
    </div>

    <div class="page-content rte" style="background: #ffffff; border-radius: var(--radius-card); padding: 30px; box-shadow: var(--shadow-card); line-height: 1.8;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "পেজ কনটেন্ট",
  "settings": []
}
{% endschema %}
