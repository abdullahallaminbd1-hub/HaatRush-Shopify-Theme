{%- assign deals_collection = collections[section.settings.collection] -%}
{%- assign has_deals = false -%}
{%- if deals_collection != blank -%}
  {%- for product in deals_collection.products limit: section.settings.products_to_show -%}
    {%- assign deal_variant = product.selected_or_first_available_variant -%}
    {%- if deal_variant.compare_at_price > deal_variant.price -%}
      {%- assign has_deals = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if has_deals -%}
<section class="featured-deals" style="padding: 40px 0;">
  <div class="container">
    <div class="section-title">
      <span>🔥 {{ section.settings.title }}</span>
      {%- if section.settings.view_all_url != blank -%}
        <a href="{{ section.settings.view_all_url }}">সব ডিল দেখুন →</a>
      {%- endif -%}
    </div>
    
    <div class="product-grid" style="margin-top: 24px;">
      {%- for product in deals_collection.products limit: section.settings.products_to_show -%}
        {%- assign deal_variant = product.selected_or_first_available_variant -%}
        {%- if deal_variant.compare_at_price > deal_variant.price -%}
          {% render 'product-card', product: product, show_badge: true %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "🔥 আজকের সেরা ডিল",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "শিরোনাম",
      "default": "আজকের সেরা ডিল"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "কালেকশন নির্বাচন করুন"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "কতটি পণ্য দেখাবেন",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "সব দেখুন লিংক"
    }
  ],
  "presets": [
    {
      "name": "🔥 আজকের সেরা ডিল"
    }
  ]
}
{% endschema %}
