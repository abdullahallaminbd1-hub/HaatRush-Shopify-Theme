<section class="featured-deals" style="padding: 40px 0;">
  <div class="container">
    <div class="section-title">
      <span>🔥 {{ section.settings.title }}</span>
      {%- if section.settings.view_all_url != blank -%}
        <a href="{{ section.settings.view_all_url }}">সব ডিল দেখুন →</a>
      {%- endif -%}
    </div>
    
    <div class="product-grid" style="margin-top: 24px;">
      {%- if section.settings.collection != blank -%}
        {%- for product in collections[section.settings.collection].products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product, show_badge: true %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="product-card__image-wrap">
              {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
            </div>
            <div class="product-card__body">
              <h3 class="product-card__title">পণ্যের নাম</h3>
              <p class="product-card__subtitle">পণ্যের বিবরণ</p>
              <div class="product-card__prices">
                <span class="product-card__price">৳1,250</span>
                <span class="product-card__compare">৳1,550</span>
              </div>
              <button class="btn-primary product-card__btn">🛒 কার্টে যোগ করুন</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "🔥 আজকের সেরা ডিল",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "শিরোনাম",
      "default": "আজকের সেরা ডিল"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "কালেকশন নির্বাচন করুন"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "কতটি পণ্য দেখাবেন",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "সব দেখুন লিংক"
    }
  ],
  "presets": [
    {
      "name": "🔥 আজকের সেরা ডিল"
    }
  ]
}
{% endschema %}
