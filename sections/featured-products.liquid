{%- assign grid_collection = collections[section.settings.collection] -%}
<section class="lf-products lf-products--{{ section.settings.tone }}" data-reveal-group>
  {%- comment -%}
    Card width (Theme Editor > Product grid > Card Width Mode / Card Width px).
    Desktop only (min-width:641px) so mobile stays exactly as before.
    Box Width caps each card at the chosen pixel value, centred in its grid
    column; Full Width leaves the card filling the column.
    Scoped to this section instance so every Product grid section controls
    its own cards, and this always wins over any global card-width setting.
    Box Width is the default so homepage grids stay compact; Full Width
    leaves the card filling the column.
  {%- endcomment -%}
  <style>
    @media(min-width:641px){
      /* Homepage Product Grid box: exactly 1400px, centred inside the 1600px
         main content area, with tighter card spacing (row 20px / column 16px
         instead of 30px / 24px). Desktop only; mobile/tablet unchanged. */
      #shopify-section-{{ section.id }} .lf-product-grid{
        width:100%;
        max-width:1400px;
        margin-left:auto;
        margin-right:auto;
        gap:20px 16px;
      }
      #shopify-section-{{ section.id }} .lf-product-card{
        {%- if section.settings.product_card_width_mode == 'box' -%}
        width:100%;
        max-width:{{ section.settings.product_card_width | default: 340 }}px;
        margin-left:auto;
        margin-right:auto;
        {%- else -%}
        max-width:none;
        {%- endif -%}
      }
    }
  </style>
  <div class="page-width">
    <div class="lf-section-head">
      <span class="lf-eyebrow">{{ section.settings.kicker }}</span>
      <h2 class="lf-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lf-section-subtitle">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="lf-product-grid lf-product-grid--{{ section.settings.columns }}">
      {%- if grid_collection.products.size > 0 -%}
        {%- for product in grid_collection.products limit: section.settings.limit -%}
          {%- render 'product-card', product: product, badge: section.settings.badge_label, button_label: section.settings.button_label, button_style: section.settings.button_style, show_vendor: section.settings.show_vendor, show_note: true, arrow: section.settings.show_arrow, quick_add: true, hide_view_details: true -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="lf-product-card">
            <a class="lf-product-card__media" href="{{ routes.all_products_collection_url }}">
              <div class="lf-product-card__placeholder">{{ i }}</div>
              {%- if section.settings.badge_label != blank -%}<span class="lf-badge">{{ section.settings.badge_label }}</span>{%- endif -%}
              {%- if section.settings.show_arrow -%}<span class="lf-card-arrow" aria-hidden="true">↗</span>{%- endif -%}
            </a>
            <div class="lf-product-card__info">
              {%- if section.settings.show_vendor -%}<span class="lf-product-card__vendor">{{ shop.name }}</span>{%- endif -%}
              <h3 class="lf-product-card__title"><a href="{{ routes.all_products_collection_url }}" title="Sample product title">{% case i %}{% when 1 %}Contour cooling wand{% when 2 %}Sculpting facial roller{% when 3 %}Precision brow trimmer{% else %}Heatless styling set{% endcase %}</a></h3>
              <p class="lf-product-card__subtitle">Thoughtfully selected</p>
              <div class="lf-product-card__price"><span class="lf-price">${{ i | plus: 17 }}.00</span></div>
              <div class="lf-product-card__actions">
                <a class="lf-card-btn lf-card-btn--{{ section.settings.button_style }}" href="{{ routes.all_products_collection_url }}" aria-label="View sample product"><span class="lf-card-btn__label">View product</span><span class="lf-card-btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.view_all_label != blank -%}
      <div class="lf-products__footer">
        <a class="lf-btn-outline" href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label }} <span aria-hidden="true">→</span></a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Product grid",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"Customer favourites"},
    {"type":"text","id":"heading","label":"Heading","default":"Our <span>Best Sellers</span>"},
    {"type":"textarea","id":"text","label":"Text","default":"Discover popular picks from across our beauty tools and devices — thoughtfully selected for modern routines."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"columns","label":"Columns","min":2,"max":4,"step":1,"default":4},
    {"type":"range","id":"limit","label":"Products shown","min":4,"max":12,"step":4,"default":8},
    {"type":"header","content":"Card width"},
    {"type":"select","id":"product_card_width_mode","label":"Card Width Mode","info":"Full Width lets cards fill their grid column. Box Width caps desktop cards at the exact width set below, centred in the column.","options":[{"value":"box","label":"Box Width"},{"value":"full","label":"Full Width"}],"default":"box"},
    {"type":"range","id":"product_card_width","label":"Card Width (px)","info":"Only applies when Card Width Mode is Box Width. Applies to desktop; mobile is unchanged.","min":200,"max":500,"step":10,"unit":"px","default":340},
    {"type":"text","id":"badge_label","label":"Badge label","default":"Best seller"},
    {"type":"checkbox","id":"show_vendor","label":"Show vendor label","default":false},
    {"type":"checkbox","id":"show_arrow","label":"Show corner arrow","default":false},
    {"type":"select","id":"button_style","label":"Card button style","options":[{"value":"filled","label":"Filled"},{"value":"outline","label":"Outline"}],"default":"filled"},
    {"type":"text","id":"button_label","label":"Card button label","default":"Add to cart"},
    {"type":"select","id":"tone","label":"Background tone","options":[{"value":"plain","label":"White"},{"value":"ivory","label":"Ivory"},{"value":"blush","label":"Blush"}],"default":"ivory"},
    {"type":"text","id":"view_all_label","label":"View all label","default":"View all best sellers"},
    {"type":"url","id":"view_all_link","label":"View all link"}
  ],
  "presets":[{"name":"Product grid"}]
}
{% endschema %}