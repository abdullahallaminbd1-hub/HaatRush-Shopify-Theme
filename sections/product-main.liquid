{%- comment -%}
  HaatRush Theme - Product Main Section
  Top fold with Product Gallery, Pricing, Badges, CTAs, Feature Icons
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
-%}

<section class="product-main-section" id="productMainSection" data-product-id="{{ product.id }}" data-variant-id="{{ current_variant.id }}" data-price-cents="{{ current_variant.price }}" data-currency="{{ cart.currency.iso_code | default: shop.currency }}">
  <div class="container">
    {%- render 'breadcrumb' -%}

    <div class="product-detail">
      <!-- LEFT: PRODUCT GALLERY -->
      <div class="product-gallery">
        <div class="product-gallery__main" id="productGalleryMain">
          {%- if product.featured_image != blank -%}
            {{ product.featured_image | image_url: width: 1200 | image_tag:
              id: 'product-main-image',
              alt: product.featured_image.alt | default: product.title,
              class: 'product-gallery__main-img',
              widths: '480, 700, 900, 1200',
              sizes: '(min-width: 769px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product-gallery__placeholder' }}
          {%- endif -%}

          <span class="product-gallery__badge badge badge--discount" data-discount-badge{% unless has_discount %} hidden{% endunless %}>
            {%- if has_discount -%}-{{ discount_percent }}%{%- endif -%}
          </span>
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs" id="productGalleryThumbs" role="tablist">
            {%- for image in product.images -%}
              <button 
                type="button"
                class="product-gallery__thumb{% if forloop.first %} is-active active{% endif %}"
                data-image-src="{{ image | image_url: width: 1200 }}"
                data-thumb-index="{{ forloop.index0 }}"
                aria-label="ছবি {{ forloop.index }}"
                onclick="window.selectProductImage && window.selectProductImage(this)"
              >
                {{ image | image_url: width: 160, height: 160, crop: 'center' | image_tag:
                  alt: image.alt | default: product.title,
                  width: 80,
                  height: 80,
                  loading: 'lazy'
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- RIGHT: PRODUCT INFO -->
      <div class="product-info">
        <!-- Badges Row -->
        <div class="product-badges">
          <span class="badge badge--discount" data-discount-badge{% unless has_discount %} hidden{% endunless %}>
            {%- if has_discount -%}-{{ discount_percent }}%{%- endif -%}
          </span>

          {%- if product.available -%}
            <span class="badge badge--stock">
              <span class="badge__dot"></span> স্টক আছে
            </span>
          {%- else -%}
            <span class="badge badge--out-of-stock">স্টক শেষ</span>
          {%- endif -%}

          {%- if section.settings.show_authenticity_badge -%}
            <span class="badge badge--outline">১০০% অরিজিনাল</span>
          {%- endif -%}
        </div>

        <!-- Title -->
        <h1 class="product-title">{{ product.title }}</h1>

        <!-- Short Subtitle / Vendor -->
        {%- if product.metafields.custom.subtitle != blank -%}
          <p class="product-subtitle">{{ product.metafields.custom.subtitle }}</p>
        {%- elsif product.vendor != blank -%}
          <p class="product-vendor">ব্র্যান্ড: <strong>{{ product.vendor }}</strong></p>
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          <div class="product-variant-selector">
            <label for="product-variant-select">ভ্যারিয়েন্ট নির্বাচন করুন</label>
            <select id="product-variant-select" aria-label="ভ্যারিয়েন্ট নির্বাচন করুন">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  data-price-cents="{{ variant.price }}"
                  data-compare-price-cents="{{ variant.compare_at_price | default: 0 }}"
                  data-price="{{ variant.price | money | escape }}"
                  data-compare-price="{{ variant.compare_at_price | money | escape }}"
                  data-available="{{ variant.available }}"
                  {% if variant.id == current_variant.id %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title | escape }}{% unless variant.available %} — {{ 'general.out_of_stock' | t }}{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endunless -%}

        <!-- Price Row -->
        <div class="product-price-row">
          <span class="product-price" id="productPriceDisplay" data-price-cents="{{ current_variant.price }}">{{ current_variant.price | money }}</span>
          {%- if has_discount -%}
            <span class="product-compare-price" id="productComparePriceDisplay">{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            <span class="product-compare-price" id="productComparePriceDisplay" hidden></span>
          {%- endif -%}
        </div>

        <!-- Quantity & Order Controls -->
        <div class="product-actions-wrap">
          <div class="product-quantity-row">
            <span class="product-quantity-label">পরিমাণ:</span>
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" id="qty-minus" aria-label="পরিমাণ কমান" onclick="window.updateQuantity && window.updateQuantity(-1)">−</button>
              <input type="number" class="quantity-input" id="product-quantity-input" name="quantity" value="1" min="1" max="99" aria-label="পরিমাণ">
              <button type="button" class="quantity-btn" id="qty-plus" aria-label="পরিমাণ বাড়ান" onclick="window.updateQuantity && window.updateQuantity(1)">+</button>
            </div>
          </div>

          <!-- CTAs -->
          <div class="product-buttons">
            {%- if product.available -%}
              <!-- Primary checkout CTA -->
              <button 
                type="button" 
                class="btn-primary product-cta-btn product-cta--buy"
                onclick="window.addProductToCart && window.addProductToCart(document.getElementById('productMainSection').dataset.variantId, true)"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                  <circle cx="12" cy="15" r="2"></circle>
                </svg>
                <span>এখনই কিনুন</span>
              </button>

              <!-- Secondary Cart CTA -->
              <button 
                type="button" 
                class="btn-outline product-cta-btn product-cta--cart js-add-to-cart-main"
                data-variant-id="{{ current_variant.id }}"
                onclick="window.addProductToCart && window.addProductToCart(document.getElementById('productMainSection').dataset.variantId, false)"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span>🛒 কার্টে যোগ করুন</span>
              </button>
            {%- else -%}
              <button type="button" class="btn-primary product-cta-btn is-disabled" disabled style="opacity: 0.6; cursor: not-allowed;">
                স্টক নেই
              </button>
            {%- endif -%}
          </div>
        </div>

        <!-- Feature Icons Row -->
        {%- if section.blocks.size > 0 -%}
          <div class="feature-icons">
            {%- for block in section.blocks -%}
              <div class="feature-icon" {{ block.shopify_attributes }}>
                <div class="feature-icon__svg">
                  {%- case block.settings.icon_type -%}
                    {%- when 'usb' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B3C3C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v10m0 0l3-3m-3 3l-3-3M7 14v3a2 2 0 002 2h6a2 2 0 002-2v-3"></path>
                      </svg>
                    {%- when 'waterproof' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B3C3C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z"></path>
                      </svg>
                    {%- when 'rgb' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B3C3C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
                      </svg>
                    {%- when 'remote' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B3C3C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="2" width="14" height="20" rx="2"></rect>
                        <circle cx="12" cy="14" r="2"></circle>
                        <line x1="12" y1="6" x2="12" y2="6"></line>
                      </svg>
                    {%- when 'warranty' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B3C3C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <polyline points="9 12 11 14 15 10"></polyline>
                      </svg>
                    {%- else -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B3C3C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                  {%- endcase -%}
                </div>
                <span class="feature-icon__label">{{ block.settings.label }}</span>
                {%- if block.settings.sublabel != blank -%}
                  <span class="feature-icon__sublabel">{{ block.settings.sublabel }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "পণ্যের মূল তথ্য",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_authenticity_badge",
      "label": "১০০% অরিজিনাল ব্যাজ দেখান",
      "default": false
    },
    {
      "type": "text",
      "id": "hotline_number",
      "label": "হটলাইন নম্বর",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "ফিচার আইকন",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "আইকন ধরন",
          "options": [
            { "value": "usb", "label": "USB Powered" },
            { "value": "waterproof", "label": "Waterproof" },
            { "value": "rgb", "label": "ARGB Color" },
            { "value": "remote", "label": "App & Remote" },
            { "value": "warranty", "label": "Warranty / Shield" }
          ],
          "default": "usb"
        },
        {
          "type": "text",
          "id": "label",
          "label": "ফিচার নাম",
          "default": "USB Powered"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "সাব-লেবেল (ঐচ্ছিক)",
          "default": "5V সাপোর্ট"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "পণ্যের মূল তথ্য"
    }
  ]
}
{% endschema %}
