{% assign related_collection = product.collections.first %}
{% if related_collection != blank and related_collection.products_count > 1 %}
  <section class="page-width related-products">
    <div class="section-heading">
      <div><span class="section-heading__icon">✦</span><div><h2>{{ section.settings.heading | escape }}</h2><p>আপনার জন্য আরও কিছু পণ্য</p></div></div>
      <a href="{{ related_collection.url }}">সব পণ্য দেখুন <span aria-hidden="true">→</span></a>
    </div>
    <div class="product-grid product-grid--home">
      {% assign shown = 0 %}
      {% for related_product in related_collection.products %}
        {% unless related_product.id == product.id %}
          {% render 'product-card', product: related_product %}
          {% assign shown = shown | plus: 1 %}
          {% if shown >= section.settings.products_to_show %}{% break %}{% endif %}
        {% endunless %}
      {% endfor %}
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "সম্পর্কিত পণ্য",
  "settings": [
    { "type": "text", "id": "heading", "label": "শিরোনাম", "default": "সম্পর্কিত পণ্য" },
    { "type": "range", "id": "products_to_show", "label": "পণ্যের সংখ্যা", "min": 2, "max": 8, "step": 2, "default": 4 }
  ]
}
{% endschema %}
