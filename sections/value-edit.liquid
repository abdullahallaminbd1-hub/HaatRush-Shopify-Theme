{%- assign value_collection = collections[section.settings.collection] -%}
<section class="lf-value-edit" data-reveal-group>
  <div class="page-width">
    <div class="lf-section-head">
      <span class="lf-eyebrow">{{ section.settings.kicker }}</span>
      <h2 class="lf-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lf-section-subtitle">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="lf-product-grid lf-product-grid--4">
      {%- if value_collection.products.size > 0 -%}
        {%- for product in value_collection.products limit: 4 -%}
          {%- render 'product-card', product: product, badge: section.settings.badge_label, button_label: section.settings.button_label, button_style: section.settings.button_style, show_vendor: true, show_note: false, arrow: true, quick_add: true, hide_view_details: true -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="lf-product-card">
            <a class="lf-product-card__media" href="{{ routes.all_products_collection_url }}">
              <div class="lf-product-card__placeholder">{{ i }}</div>
              <span class="lf-badge">{{ section.settings.badge_label }}</span>
              <span class="lf-card-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="lf-product-card__info">
              <span class="lf-product-card__vendor">{{ shop.name }}</span>
              <h3 class="lf-product-card__title"><a href="{{ routes.all_products_collection_url }}" title="নমুনা পণ্যের নাম">{% case i %}{% when 1 %}ওয়্যারলেস ইয়ারবাড{% when 2 %}স্মার্ট ওয়াচ{% when 3 %}পাওয়ার ব্যাংক{% else %}ব্লুটুথ স্পিকার{% endcase %}</a></h3>
              <p class="lf-product-card__subtitle">{{ 'general.curated_selection' | t }}</p>
              <div class="lf-product-card__price"><span class="lf-price">৳{{ i | times: 500 | plus: 1000 }}</span></div>
              <div class="lf-product-card__actions">
                <a class="lf-card-btn lf-card-btn--{{ section.settings.button_style | default: 'filled' }}" href="{{ routes.all_products_collection_url }}" aria-label="নমুনা পণ্য দেখুন"><span class="lf-card-btn__label">পণ্য দেখুন</span><span class="lf-card-btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="lf-products__footer">
      <a class="lf-btn-outline" href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label }} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Value edit",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"হাটরাশের সাশ্রয়ী বাছাই"},
    {"type":"text","id":"heading","label":"Heading","default":"৳২,০০০-এর মধ্যে পণ্য"},
    {"type":"textarea","id":"text","label":"Text","default":"দৈনন্দিন ব্যবহারের বাছাই করা ইলেকট্রনিক্স ও প্রয়োজনীয় পণ্য সাশ্রয়ী দামে দেখুন।"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"badge_label","label":"Badge label","default":"৳২,০০০-এর মধ্যে"},
    {"type":"text","id":"button_label","label":"Card button label","default":"পণ্য দেখুন"},
    {"type":"select","id":"button_style","label":"Card button style","options":[{"value":"filled","label":"Filled"},{"value":"outline","label":"Outline"}],"default":"filled"},
    {"type":"text","id":"view_all_label","label":"View all label","default":"৳২,০০০-এর মধ্যে সব পণ্য"},
    {"type":"url","id":"view_all_link","label":"View all link"}
  ],
  "presets":[{"name":"Value edit"}]
}
{% endschema %}