<section class="lf-editorial" data-reveal-group>
  <div class="page-width">
    <div class="lf-section-head">
      <span class="lf-eyebrow">{{ section.settings.kicker }}</span>
      <h2 class="lf-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lf-section-subtitle">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="lf-editorial__grid">
      {%- for block in section.blocks -%}
        <a class="lf-editorial__card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }} data-reveal>
          <div class="lf-editorial__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <div class="lf-editorial__placeholder lf-editorial__placeholder--{{ forloop.index }}"></div>
            {%- endif -%}
            <div class="lf-editorial__overlay"></div>
            <div class="lf-editorial__content">
              <span class="lf-editorial__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
              <span class="lf-editorial__link">{{ block.settings.link_label }} <span aria-hidden="true">→</span></span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
    <div class="lf-editorial__promise">
      <span>Thoughtfully selected</span><i></i><span>Secure checkout</span><i></i><span>Free US shipping</span>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Editorial cards",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"The HaatRush difference"},
    {"type":"text","id":"heading","label":"Heading","default":"Thoughtfully Selected for <span>Modern Routines</span>"},
    {"type":"textarea","id":"text","label":"Text","default":"From everyday beauty rituals to professional-grade devices, discover considered essentials selected to complement the way you live."}
  ],
  "blocks": [
    {"type":"card","name":"Card","settings":[
      {"type":"text","id":"title","label":"Title","default":"Curated Beauty Tools"},
      {"type":"textarea","id":"text","label":"Text","default":"Beauty and self-care tools selected for simple, elevated everyday routines."},
      {"type":"text","id":"link_label","label":"Link label","default":"Explore tools"},
      {"type":"url","id":"link","label":"Link"},
      {"type":"image_picker","id":"image","label":"Image"}
    ]}
  ],
  "max_blocks": 3,
  "presets":[{"name":"Editorial cards","blocks":[
    {"type":"card","settings":{"title":"Curated Beauty Tools","link_label":"Explore tools"}},
    {"type":"card","settings":{"title":"Smarter Skincare Rituals","link_label":"Explore skincare"}},
    {"type":"card","settings":{"title":"Devices That Deliver","link_label":"Discover devices"}}
  ]}]
}
{% endschema %}