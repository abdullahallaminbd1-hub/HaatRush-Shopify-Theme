<section class="lf-editorial" data-reveal-group>
  <div class="page-width">
    <div class="lf-section-head">
      <span class="lf-eyebrow">{{ section.settings.kicker }}</span>
      <h2 class="lf-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lf-section-subtitle">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="lf-editorial__grid">
      {%- for block in section.blocks -%}
        <a class="lf-editorial__card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }} data-reveal>
          <div class="lf-editorial__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <div class="lf-editorial__placeholder lf-editorial__placeholder--{{ forloop.index }}"></div>
            {%- endif -%}
            <div class="lf-editorial__overlay"></div>
            <div class="lf-editorial__content">
              <span class="lf-editorial__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
              <span class="lf-editorial__link">{{ block.settings.link_label }} <span aria-hidden="true">→</span></span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
    <div class="lf-editorial__promise">
      <span>{{ 'general.curated_selection' | t }}</span><i></i><span>{{ 'sections.footer.secure_payment' | t }}</span><i></i><span>{{ 'general.delivery_information' | t }}</span>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Editorial cards",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"হাটরাশের বিশেষত্ব"},
    {"type":"text","id":"heading","label":"Heading","default":"<span>আধুনিক জীবনের</span> উপযোগী বাছাই"},
    {"type":"textarea","id":"text","label":"Text","default":"প্রতিদিনের প্রয়োজন থেকে স্মার্ট ডিভাইস—আপনার জীবনযাত্রার সঙ্গে মানানসই পণ্য খুঁজে নিন।"}
  ],
  "blocks": [
    {"type":"card","name":"Card","settings":[
      {"type":"text","id":"title","label":"Title","default":"প্রতিদিনের ইলেকট্রনিক্স"},
      {"type":"textarea","id":"text","label":"Text","default":"দৈনন্দিন কাজ সহজ করতে বাছাই করা ডিভাইস ও অ্যাক্সেসরিজ।"},
      {"type":"text","id":"link_label","label":"Link label","default":"পণ্য দেখুন"},
      {"type":"url","id":"link","label":"Link"},
      {"type":"image_picker","id":"image","label":"Image"}
    ]}
  ],
  "max_blocks": 3,
  "presets":[{"name":"Editorial cards","blocks":[
    {"type":"card","settings":{"title":"প্রতিদিনের ইলেকট্রনিক্স","link_label":"পণ্য দেখুন"}},
    {"type":"card","settings":{"title":"স্মার্ট ডিভাইস","link_label":"ডিভাইস দেখুন"}},
    {"type":"card","settings":{"title":"কাজের উপযোগী প্রযুক্তি","link_label":"আরও জানুন"}}
  ]}]
}
{% endschema %}