{%- comment -%} HaatRush Theme - Shopify Admin API COD checkout {%- endcomment -%}

<section class="checkout-page-section hr-checkout" id="checkoutPageSection" data-checkout-app data-proxy-root="/apps/haatrush-checkout">
  <div class="container">
    {%- render 'breadcrumb' -%}

    <div class="checkout-header-block">
      <h1 class="checkout-page-title">চেকআউট</h1>
      <p class="checkout-page-subtitle">নিরাপদে অর্ডার সম্পন্ন করতে ডেলিভারির তথ্য দিন। পণ্য হাতে পেয়ে মূল্য পরিশোধ করুন।</p>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="checkout-layout hr-checkout__layout" data-checkout-content>
        <div class="checkout-form-column">
          <form class="checkout-card hr-checkout__form" data-checkout-form novalidate>
            <div class="checkout-card__header">
              <div class="checkout-card__icon-box" aria-hidden="true">⌖</div>
              <div class="checkout-card__title-box">
                <h2 class="checkout-card__title">ডেলিভারির তথ্য</h2>
                <p class="checkout-card__subtitle">আপনার অর্ডার পৌঁছে দিতে সঠিক তথ্য দিন</p>
              </div>
            </div>
            <div class="hr-checkout__fields">
              <label class="hr-checkout__field">
                <span>আপনার পূর্ণ নাম <b aria-hidden="true">*</b></span>
                <input name="name" type="text" autocomplete="name" maxlength="120" required>
              </label>
              <label class="hr-checkout__field">
                <span>মোবাইল নম্বর <b aria-hidden="true">*</b></span>
                <input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" placeholder="০১XXXXXXXXX" required>
              </label>
              <label class="hr-checkout__field">
                <span>বিভাগ <b aria-hidden="true">*</b></span>
                <select name="division" autocomplete="address-level1" required disabled>
                  <option value="">বিভাগ নির্বাচন করুন</option>
                </select>
              </label>
              <label class="hr-checkout__field">
                <span>জেলা <b aria-hidden="true">*</b></span>
                <select name="district" autocomplete="address-level2" required disabled>
                  <option value="">জেলা নির্বাচন করুন</option>
                </select>
              </label>
              <label class="hr-checkout__field">
                <span>উপজেলা/থানা <b aria-hidden="true">*</b></span>
                <select name="upazila" autocomplete="address-level3" required disabled>
                  <option value="">উপজেলা/থানা নির্বাচন করুন</option>
                </select>
              </label>
            </div>
            <div class="hr-checkout__cod">
              <span class="hr-checkout__cod-icon" aria-hidden="true">৳</span>
              <span><strong>ক্যাশ অন ডেলিভারি</strong><small>পণ্য হাতে পেয়ে টাকা পরিশোধ করুন</small></span>
              <span class="hr-checkout__cod-selected" aria-label="নির্বাচিত">✓</span>
            </div>
            <label class="hr-checkout__field hr-checkout__field--wide hr-checkout__address">
              <span>সম্পূর্ণ ঠিকানা <b aria-hidden="true">*</b></span>
              <textarea name="address" autocomplete="street-address" rows="3" maxlength="500" placeholder="বাড়ি/রোড নম্বর, এলাকা ও বিস্তারিত ঠিকানা" required></textarea>
            </label>
            <p class="hr-checkout__service-notice" data-checkout-service-notice role="status" aria-live="polite" hidden>
              দুঃখিত, এই মুহূর্তে অর্ডার নেওয়া যাচ্ছে না। আপনার কার্ট সংরক্ষিত আছে—কিছুক্ষণ পর আবার চেষ্টা করুন।
            </p>
            <p class="hr-checkout__notice" data-checkout-error role="alert" hidden></p>
            <button type="submit" class="btn-primary checkout-submit-btn hr-checkout__submit" data-checkout-submit disabled>
              <span data-checkout-submit-label>অর্ডার যাচাই হচ্ছে…</span>
              <span aria-hidden="true">→</span>
            </button>
            <p class="hr-checkout__privacy">অর্ডার সম্পন্ন হলে আপনার তথ্য ডেলিভারির জন্য ব্যবহার করা হবে।</p>
          </form>
        </div>

        <!-- RIGHT COLUMN: ORDER SUMMARY (40%) -->
        <div class="checkout-summary-column">
          <div class="checkout-card checkout-card--summary">
            <div class="checkout-card__header">
              <div class="checkout-card__icon-box" aria-hidden="true">▣</div>
              <div class="checkout-card__title-box">
                <h2 class="checkout-card__title">আপনার অর্ডার</h2>
                <p class="checkout-card__subtitle">আপনার নির্বাচিত পণ্য ও মোট খরচ</p>
              </div>
            </div>

            <div class="checkout-items-list hr-checkout__items" data-checkout-items aria-live="polite">
              <p class="hr-checkout__loading">কার্ট ও বর্তমান দাম যাচাই হচ্ছে…</p>
            </div>

            <div class="hr-checkout__offer" data-checkout-bundle>
              <div class="hr-checkout__offer-heading"><span class="hr-checkout__offer-icon">%</span><span><strong>বান্ডেল সেভিংস</strong><small>২টি বা তার বেশি পণ্যে ২% ছাড়</small></span><b data-bundle-status>যাচাই হচ্ছে</b></div>
              <div class="hr-checkout__track" role="progressbar" aria-label="বান্ডেল সেভিংসের অগ্রগতি" aria-valuemin="0" aria-valuemax="2" aria-valuenow="0"><i data-bundle-fill></i></div>
              <p data-bundle-message aria-live="polite">কার্ট যাচাই হচ্ছে…</p>
            </div>
            <div class="hr-checkout__offer" data-checkout-shipping>
              <div class="hr-checkout__offer-heading"><span class="hr-checkout__offer-icon">৳</span><span><strong>ফ্রি শিপিং</strong><small>৳১,০০০-এর বেশি পণ্য কিনলে ডেলিভারি ফ্রি</small></span><b data-shipping-status>যাচাই হচ্ছে</b></div>
              <div class="hr-checkout__track" role="progressbar" aria-label="ফ্রি শিপিংয়ের অগ্রগতি" aria-valuemin="0" aria-valuemax="100001" aria-valuenow="0"><i data-shipping-fill></i></div>
              <p data-shipping-message aria-live="polite">কার্ট যাচাই হচ্ছে…</p>
            </div>

            <div class="checkout-totals-box hr-checkout__totals">
              <div class="checkout-total-row"><span class="checkout-total-label">পণ্যের মোট (<span data-checkout-count>০</span> টি)</span><span class="checkout-total-val" data-checkout-subtotal>—</span></div>
              <div class="checkout-total-row hr-checkout__discount"><span class="checkout-total-label">বান্ডেল সেভিংস (২%)</span><span class="checkout-total-val" data-checkout-discount>—</span></div>
              <div class="checkout-total-row"><span class="checkout-total-label">ডেলিভারি চার্জ</span><span class="checkout-total-val" data-checkout-shipping-total>জেলা নির্বাচন করুন</span></div>
              <div class="checkout-total-row hr-checkout__grand-total"><strong>সর্বমোট</strong><strong data-checkout-total>—</strong></div>
              <p class="hr-checkout__tax-note">অর্ডার নিশ্চিত করার আগে পণ্যের মূল্য ও প্রাপ্যতা আবার মিলিয়ে নেওয়া হবে।</p>
            </div>

            <div class="hr-checkout__confirmation" data-checkout-confirmation role="status" aria-live="assertive" hidden>
              <span class="hr-checkout__success-mark" aria-hidden="true">✓</span>
              <h2>অর্ডার সফল হয়েছে</h2>
              <p data-confirmation-message></p>
              <p>ক্যাশ অন ডেলিভারি — পণ্য হাতে পেয়ে মূল্য পরিশোধ করুন।</p>
            </div>
            <p class="checkout-security-note">অর্ডার সফলভাবে জমা হলে নিশ্চিতকরণ দেখানো হবে।</p>
          </div>
        </div>
      </div>
      <div class="checkout-empty-state" data-checkout-empty hidden>
        <div class="checkout-empty-state__icon" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#5A1EB0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </div>
        <h2 class="checkout-empty-state__title">আপনার কার্ট বর্তমানে খালি আছে</h2>
        <p class="checkout-empty-state__desc">আপনার পছন্দের পণ্য বেছে নিতে আমাদের শপ ঘুরে দেখুন।</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary hr-checkout__empty-link">
          <span>কেনাকাটা চালিয়ে যান →</span>
        </a>
      </div>
    {%- else -%}
      <!-- Empty Cart State -->
      <div class="checkout-empty-state">
        <div class="checkout-empty-state__icon">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#5A1EB0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </div>
        <h2 class="checkout-empty-state__title">আপনার কার্ট বর্তমানে খালি আছে</h2>
        <p class="checkout-empty-state__desc">আপনার পছন্দের ইলেকট্রনিক্স পণ্য বাছাই করতে আমাদের শপ ঘুরে দেখুন।</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top: 20px;">
          <span>সব পণ্য দেখুন →</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "কার্ট পর্যালোচনা",
  "settings": []
}
{% endschema %}
