{%- comment -%} HaatRush Theme - Shopify cart review {%- endcomment -%}

<section class="checkout-page-section hr-checkout" id="checkoutPageSection" data-cart-review data-cart-root="{{ routes.root_url }}" data-cart-load-error="কার্টের তথ্য লোড করা যায়নি। পৃষ্ঠাটি রিফ্রেশ করুন।" data-unpriced-label="চেকআউটে হিসাব হবে" data-eligibility-label="যোগ্যতা পূরণ" data-shipping-remaining-suffix=" বাকি" data-quantity-decrease-label="পরিমাণ কমান" data-quantity-increase-label="পরিমাণ বাড়ান" data-remove-suffix=" কার্ট থেকে সরান">
  <div class="container">
    {%- render 'breadcrumb' -%}

    <div class="checkout-header-block">
      <h1 class="checkout-page-title">অর্ডার পর্যালোচনা</h1>
      <p class="checkout-page-subtitle">আপনার পণ্য ও অফারের অগ্রগতি দেখে Shopify চেকআউটে এগিয়ে যান।</p>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="checkout-layout hr-checkout__layout" data-checkout-content>
        <div class="checkout-form-column">
          <div class="checkout-card hr-checkout__form hr-checkout__info">
            <div class="checkout-card__header">
              <div class="checkout-card__icon-box" aria-hidden="true">✓</div>
              <div class="checkout-card__title-box">
                <h2 class="checkout-card__title">চেকআউটের আগে</h2>
                <p class="checkout-card__subtitle">অর্ডারটি একবার দেখে নিন</p>
              </div>
            </div>
            <p class="hr-checkout__info-copy">পরের ধাপে Shopify চেকআউটে ডেলিভারির ঠিকানা দিন এবং সেখানে সক্রিয় পেমেন্ট পদ্ধতি বেছে নিন।</p>
            <p class="hr-checkout__info-copy">ডেলিভারি চার্জ ও চূড়ান্ত মোট Shopify চেকআউটে হিসাব হবে।</p>
            <a href="{{ routes.root_url }}checkout" class="btn-primary hr-checkout__submit">
              <span>Shopify চেকআউটে এগিয়ে যান</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- RIGHT COLUMN: ORDER SUMMARY (40%) -->
        <div class="checkout-summary-column">
          <div class="checkout-card checkout-card--summary hr-checkout__summary">
            <div class="checkout-card__header">
              <div class="checkout-card__icon-box" aria-hidden="true">▣</div>
              <div class="checkout-card__title-box">
                <h2 class="checkout-card__title">আপনার অর্ডার</h2>
                <p class="checkout-card__subtitle">আপনার নির্বাচিত পণ্য ও মোট খরচ</p>
              </div>
            </div>

            <div class="checkout-items-list hr-checkout__items" data-checkout-items aria-live="polite">
              {%- for item in cart.items -%}
                <article class="hr-checkout__item">
                  {%- if item.image -%}
                    <img class="hr-checkout__item-image" src="{{ item.image | image_url: width: 160 }}" alt="{{ item.product.title | escape }}" width="68" height="68" loading="lazy">
                  {%- else -%}
                    <span class="hr-checkout__item-image hr-checkout__item-placeholder" aria-hidden="true">◇</span>
                  {%- endif -%}
                  <div class="hr-checkout__item-info">
                    <strong class="hr-checkout__item-title">{{ item.product.title | escape }}</strong>
                    {%- unless item.product.has_only_default_variant -%}
                      <small class="hr-checkout__item-variant">{{ item.variant.title | escape }}</small>
                    {%- endunless -%}
                    <div class="hr-checkout__item-controls">
                      <button type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="পরিমাণ কমান">−</button>
                      <span>{{ item.quantity }}</span>
                      <button type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="পরিমাণ বাড়ান">+</button>
                    </div>
                  </div>
                  <strong class="hr-checkout__item-price">{{ item.final_line_price | money }}</strong>
                  <button type="button" class="checkout-item__remove-btn" data-remove-item data-line="{{ forloop.index }}" aria-label="{{ item.product.title | escape }} কার্ট থেকে সরান">×</button>
                </article>
              {%- endfor -%}
            </div>

            <div class="hr-checkout__offer" data-checkout-bundle>
              <div class="hr-checkout__offer-heading"><span class="hr-checkout__offer-icon">%</span><span><strong>বান্ডেল সেভিংস</strong><small>২টি বা তার বেশি পণ্যে ২% ছাড়ের যোগ্যতা</small></span><b data-bundle-status data-complete-label="যোগ্যতা পূরণ">০ / ২</b></div>
              <div class="hr-checkout__track" role="progressbar" aria-label="বান্ডেল সেভিংসের অগ্রগতি" aria-valuemin="0" aria-valuemax="2" aria-valuenow="0"><i data-bundle-fill></i></div>
              <p data-bundle-message aria-live="polite">ছাড় Shopify চেকআউটে প্রযোজ্য হলে দেখানো হবে।</p>
            </div>
            <div class="hr-checkout__offer" data-checkout-shipping>
              <div class="hr-checkout__offer-heading"><span class="hr-checkout__offer-icon">৳</span><span><strong>ফ্রি শিপিং</strong><small>৳১,০০০-এর বেশি কেনাকাটায় যোগ্যতা</small></span><b data-shipping-status data-complete-label="যোগ্যতা পূরণ">৳১,০০০-এর বেশি বাকি</b></div>
              <div class="hr-checkout__track" role="progressbar" aria-label="ফ্রি শিপিংয়ের অগ্রগতি" aria-valuemin="0" aria-valuemax="100001" aria-valuenow="0"><i data-shipping-fill></i></div>
              <p data-shipping-message aria-live="polite">চূড়ান্ত শিপিং চার্জ Shopify চেকআউটে নিশ্চিত হবে।</p>
            </div>

            <div class="checkout-totals-box hr-checkout__totals">
              <div class="checkout-total-row"><span class="checkout-total-label">পণ্যের মোট (<span data-checkout-count>{{ cart.item_count }}</span> টি)</span><span class="checkout-total-val" data-checkout-subtotal>{{ cart.original_total_price | money }}</span></div>
              <div class="checkout-total-row hr-checkout__discount"><span class="checkout-total-label">Shopify-তে প্রয়োগ ছাড়</span><span class="checkout-total-val" data-checkout-discount>{{ cart.total_discount | money }}</span></div>
              <div class="checkout-total-row"><span class="checkout-total-label">ডেলিভারি চার্জ</span><span class="checkout-total-val" data-checkout-shipping-total>চেকআউটে হিসাব হবে</span></div>
              <div class="checkout-total-row hr-checkout__grand-total"><strong>মোট (শিপিং বাদে)</strong><strong data-checkout-total>{{ cart.total_price | money }}</strong></div>
            </div>
          </div>
        </div>
      </div>
      <div class="checkout-empty-state" data-checkout-empty hidden>
        <div class="checkout-empty-state__icon" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#5A1EB0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </div>
        <h2 class="checkout-empty-state__title">আপনার কার্ট বর্তমানে খালি আছে</h2>
        <p class="checkout-empty-state__desc">আপনার পছন্দের পণ্য বেছে নিতে আমাদের শপ ঘুরে দেখুন।</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary hr-checkout__empty-link">
          <span>কেনাকাটা চালিয়ে যান →</span>
        </a>
      </div>
    {%- else -%}
      <div class="checkout-empty-state" data-checkout-empty>
        <div class="checkout-empty-state__icon">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#5A1EB0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </div>
        <h2 class="checkout-empty-state__title">আপনার কার্ট বর্তমানে খালি আছে</h2>
        <p class="checkout-empty-state__desc">আপনার পছন্দের ইলেকট্রনিক্স পণ্য বাছাই করতে আমাদের শপ ঘুরে দেখুন।</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top: 20px;">
          <span>সব পণ্য দেখুন →</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "কার্ট পর্যালোচনা",
  "settings": []
}
{% endschema %}
