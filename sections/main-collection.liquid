<section class="collection-page">
  <div class="collection-intro">
    <span class="eyebrow">বাছাই করা পণ্য / {{ collection.products_count }}টি</span>
    <h1>{{ collection.title }}</h1>
    <p>{{ collection.description | default: 'দৈনন্দিন ব্যবহারের জন্য বাছাই করা ইলেকট্রনিক্স, গ্যাজেট, অডিও পণ্য ও অ্যাক্সেসরিজ।' }}</p>
  </div>

  {% paginate collection.products by 12 %}
  <div class="collection-toolbar">
    <button class="filter-toggle" data-filter-open>{{ 'sections.collection.filter' | t }} <span>＋</span></button>
    <span class="collection-count">{{ paginate.collection_item_count }} {{ 'general.products' | t }}</span>
    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
    <form class="sort-label" method="get" action="{{ routes.collections_url }}/{{ collection.handle }}">
      <label for="SortBy">{{ 'sections.collection.sort_by' | t }}</label>
      <select id="SortBy" name="sort_by" onchange="this.form.submit()">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  <div class="collection-layout">
    <aside class="filter-panel" data-filter-panel>
      <div class="filter-panel__header"><strong>{{ 'sections.collection.filter' | t }}</strong><button class="icon-button" data-filter-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button></div>
      <form action="{{ routes.collections_url }}/{{ collection.handle }}">
        {%- for filter in collection.filters -%}
          <div class="filter-group">
            <strong>{{ filter.label }}</strong>
            {%- case filter.type -%}
              {%- when 'boolean' or 'list' -%}
                {%- for value in filter.values -%}
                  <label>
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                    {{ value.label }} <span>{{ value.count }}</span>
                  </label>
                {%- endfor -%}
              {%- when 'price_range' -%}
                <div class="price-filter">
                  <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ 'sections.collection.min_price' | t }}" inputmode="decimal" aria-label="{{ 'sections.collection.min_price' | t }}">
                  <span>–</span>
                  <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ 'sections.collection.max_price' | t }}" inputmode="decimal" aria-label="{{ 'sections.collection.max_price' | t }}">
                </div>
              {%- else -%}
                <p>{{ 'general.no_results' | t }}</p>
            {%- endcase -%}
          </div>
        {%- endfor -%}
        <div class="filter-actions"><button class="button button--dark" type="submit">{{ 'sections.collection.apply_filters' | t }}</button><a class="text-link" href="{{ routes.collections_url }}/{{ collection.handle }}">{{ 'sections.collection.reset' | t }}</a></div>
      </form>
    </aside>

    <div class="collection-results">
      <div class="product-grid product-grid--collection">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- else -%}
          <p class="empty-collection">{{ 'sections.collection.no_products' | t }}</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'general.page' | t }}">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← {{ 'general.previous' | t }}</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page %}<span class="pagination__active" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.next' | t }} →</a>{%- endif -%}
      </nav>
      {%- endif -%}
    </div>
  </div>
  {% endpaginate %}
</section>
{% schema %}{"name":"Main collection","settings":[],"presets":[{"name":"Main collection"}]}{% endschema %}
