<section class="collection-page">
  <div class="collection-intro">
    <span class="eyebrow">Curated tools / {{ collection.products_count }} pieces</span>
    <h1>{{ collection.title }}</h1>
    <p>{{ collection.description | default: 'Beauty devices, facial tools, hair accessories, and personal-care essentials selected for modern routines.' }}</p>
  </div>

  {% paginate collection.products by 12 %}
  <div class="collection-toolbar">
    <button class="filter-toggle" data-filter-open>Filter <span>＋</span></button>
    <span class="collection-count">{{ paginate.collection_item_count }} products</span>
    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
    <form class="sort-label" method="get" action="{{ routes.collections_url }}/{{ collection.handle }}">
      <label for="SortBy">Sort by</label>
      <select id="SortBy" name="sort_by" onchange="this.form.submit()">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  <div class="collection-layout">
    <aside class="filter-panel" data-filter-panel>
      <div class="filter-panel__header"><strong>Filter</strong><button class="icon-button" data-filter-close aria-label="Close filters">{% render 'icon', icon: 'close' %}</button></div>
      <form action="{{ routes.collections_url }}/{{ collection.handle }}">
        {%- for filter in collection.filters -%}
          <div class="filter-group">
            <strong>{{ filter.label }}</strong>
            {%- case filter.type -%}
              {%- when 'boolean' or 'list' -%}
                {%- for value in filter.values -%}
                  <label>
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                    {{ value.label }} <span>{{ value.count }}</span>
                  </label>
                {%- endfor -%}
              {%- when 'price_range' -%}
                <div class="price-filter">
                  <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="Min" inputmode="decimal" aria-label="Minimum price">
                  <span>–</span>
                  <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="Max" inputmode="decimal" aria-label="Maximum price">
                </div>
              {%- else -%}
                <p>No additional filters.</p>
            {%- endcase -%}
          </div>
        {%- endfor -%}
        <div class="filter-actions"><button class="button button--dark" type="submit">Apply filters</button><a class="text-link" href="{{ routes.collections_url }}/{{ collection.handle }}">Reset</a></div>
      </form>
    </aside>

    <div class="collection-results">
      <div class="product-grid product-grid--collection">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- else -%}
          <p class="empty-collection">No products yet. Add products in Shopify Admin to populate this collection.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Previous</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page %}<span class="pagination__active" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
      </nav>
      {%- endif -%}
    </div>
  </div>
  {% endpaginate %}
</section>
{% schema %}{"name":"Main collection","settings":[],"presets":[{"name":"Main collection"}]}{% endschema %}
