<section class="page-width collection-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">হোম</a><span>›</span><span>{{ collection.title | escape }}</span></nav>
  <div class="collection-layout">
    <aside class="collection-sidebar">
      <h2>{% render 'icon', name: 'filter' %} ফিল্টার করুন</h2>
      <form id="CollectionFilters" class="filter-form">
        {% if collection.filters.size > 0 %}
          {% for filter in collection.filters %}
            <fieldset class="filter-group">
              <legend>{{ filter.label | escape }}</legend>
              {% case filter.type %}
                {% when 'list' %}
                  {% for value in filter.values %}
                    <label class="filter-option">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      <span>{{ value.label | escape }} ({{ value.count }})</span>
                    </label>
                  {% endfor %}
                {% when 'boolean' %}
                  <label class="filter-option"><input type="checkbox" name="{{ filter.param_name }}" value="{{ filter.true_value.value }}" {% if filter.true_value.active %}checked{% endif %}><span>{{ filter.label | escape }}</span></label>
                {% when 'price_range' %}
                  <div class="price-range-fields">
                    <label><span>সর্বনিম্ন</span><input name="{{ filter.min_value.param_name }}" type="number" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" placeholder="৳ ০"></label>
                    <label><span>সর্বোচ্চ</span><input name="{{ filter.max_value.param_name }}" type="number" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_max | money_without_currency }}"></label>
                  </div>
              {% endcase %}
            </fieldset>
          {% endfor %}
          <button class="button button--primary button--small" type="submit">ফিল্টার প্রয়োগ করুন</button>
          <a class="filter-reset" href="{{ collection.url }}">সব ফিল্টার মুছুন</a>
        {% else %}
          <p class="filter-empty">পণ্য যোগ হলে উপলভ্য ফিল্টার এখানে দেখা যাবে।</p>
        {% endif %}
      </form>
    </aside>
    <div class="collection-results">
      <div class="collection-title">
        <div><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="collection-description">{{ collection.description }}</div>{% else %}<p>আপনার দৈনন্দিন জীবনের প্রয়োজনীয় ইলেকট্রনিক্স পণ্য এক জায়গায়।</p>{% endif %}</div>
        <form class="sort-form" method="get">
          {% for filter in collection.filters %}{% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}">{% endif %}{% if filter.max_value.value %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}">{% endif %}{% endif %}{% endfor %}
          <label for="CollectionSort">সাজান</label>
          <select id="CollectionSort" name="sort_by" onchange="this.form.submit()">
            {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
            {% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}
          </select>
        </form>
      </div>
      <p class="result-count">{{ collection.products_count }} টি পণ্য</p>
      {% paginate collection.products by section.settings.products_per_page %}
        {% if collection.products.size > 0 %}
          <div class="product-grid product-grid--collection">
            {% for product in collection.products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>
        {% else %}
          <div class="empty-collection"><h2>এই সংগ্রহে এখনো পণ্য নেই</h2><p>নতুন পণ্য যোগ হলে এখানে দেখা যাবে।</p><a class="button button--primary" href="{{ routes.all_products_collection_url }}">সকল পণ্য দেখুন</a></div>
        {% endif %}
        {% if paginate.pages > 1 %}
          <nav class="pagination" role="navigation" aria-label="Pagination">
            {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="আগের পৃষ্ঠা">‹</a>{% endif %}
            {% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% else %}<span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>{% endif %}{% endfor %}
            {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="পরের পৃষ্ঠা">›</a>{% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
  <div class="benefits-strip benefits-strip--compact">
    <div class="benefit">{% render 'icon', name: 'truck' %}<div><strong>সারা দেশে ডেলিভারি</strong><span>৬৪ জেলা জুড়ে</span></div></div>
    <div class="benefit">{% render 'icon', name: 'shield' %}<div><strong>নিরাপদ কেনাকাটা</strong><span>নিরাপদ অর্ডার</span></div></div>
    <div class="benefit">{% render 'icon', name: 'cash' %}<div><strong>ক্যাশ অন ডেলিভারি</strong><span>পণ্য হাতে পেয়ে মূল্য দিন</span></div></div>
    <div class="benefit">{% render 'icon', name: 'headset' %}<div><strong>গ্রাহক সহায়তা</strong><span>আমরা আপনার পাশে</span></div></div>
  </div>
</section>

{% schema %}
{
  "name": "পণ্য সংগ্রহ",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 32, "step": 4, "default": 16, "label": "প্রতি পাতায় পণ্য" },
    { "type": "checkbox", "id": "show_vendor", "label": "ব্র্যান্ড দেখান", "default": false }
  ]
}
{% endschema %}
