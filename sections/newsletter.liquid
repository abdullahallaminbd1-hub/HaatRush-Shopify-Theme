<section class="newsletter"><div><span class="eyebrow">{{ 'general.newsletter_kicker' | t }}</span><h2>{{ 'general.newsletter_heading' | t }}</h2></div><div><p>{{ 'general.newsletter_blurb' | t }}</p>{% form 'customer', class: 'newsletter-form' %}<input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_email' | t }}" aria-label="{{ 'general.email' | t }}" required><button class="button button--dark" type="submit">{{ 'general.subscribe' | t }} <span>→</span></button>{% endform %}<small>{{ 'general.newsletter_note' | t }}</small></div></section>