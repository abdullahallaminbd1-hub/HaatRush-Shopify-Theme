{% assign current_variant = product.selected_or_first_available_variant %}
<section class="page-width product-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">হোম</a><span>›</span>{% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a><span>›</span>{% endif %}<span>{{ product.title | escape }}</span></nav>
  <div class="product-hero">
    <div class="product-gallery">
      <div class="product-gallery__main">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 1400 | image_tag: class: 'product-main-image', loading: 'eager', widths: '500, 800, 1100, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: product.featured_image.alt | default: product.title }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      {% if product.media.size > 1 %}
        <div class="product-gallery__thumbs">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <button type="button" class="gallery-thumb{% if forloop.first %} is-active{% endif %}" data-gallery-image="{{ media | image_url: width: 1400 }}" aria-label="{{ product.title | escape }} ছবি {{ forloop.index }}">
                {{ media | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="product-summary">
      {% if current_variant.available %}<span class="stock-label"><i></i> স্টকে আছে</span>{% else %}<span class="stock-label stock-label--out">স্টক শেষ</span>{% endif %}
      <h1>{{ product.title | escape }}</h1>
      {% render 'price', product: product %}
      {% if product.description != blank %}
        <div class="product-short-description">{{ product.description | strip_html | truncate: 240 }}</div>
      {% endif %}
      {% form 'product', product, id: 'ProductForm', class: 'product-form' %}
        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% else %}
          <label class="field-label" for="ProductVariant">ভ্যারিয়েন্ট</label>
          <select id="ProductVariant" name="id" class="field-input" data-variant-select>
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — স্টক শেষ{% endunless %}</option>
            {% endfor %}
          </select>
        {% endif %}
        <div class="product-form__actions">
          <div class="quantity-picker" data-quantity-picker>
            <button type="button" data-qty-step="-1" aria-label="পরিমাণ কমান">−</button>
            <input name="quantity" type="number" value="1" min="1" aria-label="পরিমাণ">
            <button type="button" data-qty-step="1" aria-label="পরিমাণ বাড়ান">+</button>
          </div>
          <button class="button button--primary product-buy-button" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %}>{% render 'icon', name: 'cart' %} কার্টে যোগ করুন</button>
        </div>
        <p class="form-status" data-product-status role="status" aria-live="polite"></p>
      {% endform %}
      <div class="product-promises">
        <div>{% render 'icon', name: 'truck' %}<strong>সারা দেশে ডেলিভারি</strong><span>বাংলাদেশ জুড়ে</span></div>
        <div>{% render 'icon', name: 'cash' %}<strong>ক্যাশ অন ডেলিভারি</strong><span>পণ্য পেয়ে মূল্য দিন</span></div>
        <div>{% render 'icon', name: 'shield' %}<strong>নিরাপদ কেনাকাটা</strong><span>নিরাপদ অর্ডার</span></div>
      </div>
    </div>
  </div>
  <div class="product-description-panel">
    <div class="product-description-panel__heading"><h2>পণ্যের বিবরণ</h2><span>স্পেসিফিকেশন ও বিস্তারিত তথ্য</span></div>
    <div class="product-description-panel__body rte">{{ product.description }}</div>
  </div>
</section>

<script type="application/json" data-product-variants>{{ product.variants | json }}</script>

{% schema %}
{
  "name": "পণ্যের বিস্তারিত",
  "settings": []
}
{% endschema %}
