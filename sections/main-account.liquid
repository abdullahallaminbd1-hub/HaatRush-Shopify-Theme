<section class="account-page"><div class="content-page__intro"><span class="eyebrow">HaatRush / your account</span><h1>Welcome back.</h1><p>Review orders, manage your details, and keep your favorite tools close.</p></div>{% if customer %}<div class="account-panel"><div><span class="eyebrow">Signed in as</span><h2>{{ customer.email }}</h2></div><a class="button button--dark" href="{{ routes.account_logout_url }}">Log out <span>→</span></a></div><div class="account-orders"><h2>Order history</h2>{% if customer.orders.size > 0 %}{% for order in customer.orders %}<div class="order-row"><span>{{ order.name }}</span><span>{{ order.created_at | date: '%B %d, %Y' }}</span><span>{{ order.total_price | money }}</span><span>{{ order.fulfillment_status_label }}</span></div>{% endfor %}{% else %}<p>No orders yet. Your first ritual tool is waiting.</p>{% endif %}</div>{% else %}<div class="account-panel"><p>You’re not signed in.</p><a class="button button--accent" href="{{ routes.account_login_url }}">Sign in <span>→</span></a><a class="text-link" href="{{ routes.account_register_url }}">Create an account <span>↗</span></a></div>{% endif %}</section>
{% schema %}{"name":"Account page","settings":[],"presets":[{"name":"Account page"}]}{% endschema %}