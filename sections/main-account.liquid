<section class="account-page"><div class="content-page__intro"><span class="eyebrow">{{ 'general.account' | t }}</span><h1>{{ 'general.account' | t }}</h1><p>{{ 'general.account' | t }}</p></div>{% if customer %}<div class="account-panel"><div><span class="eyebrow">{{ 'general.sign_in' | t }}</span><h2>{{ customer.email }}</h2></div><a class="button button--dark" href="{{ routes.account_logout_url }}">{{ 'general.sign_out' | t }} <span>→</span></a></div><div class="account-orders"><h2>{{ 'general.track_your_order' | t }}</h2>{% if customer.orders.size > 0 %}{% for order in customer.orders %}<div class="order-row"><span>{{ order.name }}</span><span>{{ order.created_at | date: '%B %d, %Y' }}</span><span>{{ order.total_price | money }}</span><span>{{ order.fulfillment_status_label }}</span></div>{% endfor %}{% else %}<p>{{ 'general.no_products' | t }}</p>{% endif %}</div>{% else %}<div class="account-panel"><p>{{ 'general.sign_in' | t }}</p><a class="button button--accent" href="{{ routes.account_login_url }}">{{ 'general.sign_in' | t }} <span>→</span></a><a class="text-link" href="{{ routes.account_register_url }}">{{ 'general.account' | t }} <span>↗</span></a></div>{% endif %}</section>
{% schema %}{"name":"Account page","settings":[],"presets":[{"name":"Account page"}]}{% endschema %}