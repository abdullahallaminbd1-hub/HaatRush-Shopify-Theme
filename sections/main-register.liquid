<section class="auth-page"><div class="auth-card"><span class="eyebrow">{{ 'general.account' | t }}</span><h1>{{ 'general.account' | t }}</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<label>{{ 'general.name' | t }}<input type="text" name="customer[first_name]" required></label><label>{{ 'general.name' | t }}<input type="text" name="customer[last_name]" required></label><label>{{ 'general.email' | t }}<input type="email" name="customer[email]" required></label><label>পাসওয়ার্ড<input type="password" name="customer[password]" required></label><button class="button button--accent button--full" type="submit">অ্যাকাউন্ট তৈরি করুন <span>→</span></button>{% endform %}<a class="text-link" href="{{ routes.account_login_url }}">{{ 'general.sign_in' | t }} <span>↗</span></a></div></section>
{% schema %}{"name":"Register page","settings":[],"presets":[{"name":"Register page"}]}{% endschema %}