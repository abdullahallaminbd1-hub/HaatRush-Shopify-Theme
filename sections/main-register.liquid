<section class="auth-page"><div class="auth-card"><span class="eyebrow">HaatRush / account</span><h1>Create account</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<label>First name<input type="text" name="customer[first_name]" required></label><label>Last name<input type="text" name="customer[last_name]" required></label><label>Email<input type="email" name="customer[email]" required></label><label>Password<input type="password" name="customer[password]" required></label><button class="button button--accent button--full" type="submit">Create account <span>→</span></button>{% endform %}<a class="text-link" href="{{ routes.account_login_url }}">Already have an account? Sign in <span>↗</span></a></div></section>
{% schema %}{"name":"Register page","settings":[],"presets":[{"name":"Register page"}]}{% endschema %}