{%- comment -%}
  Collection Filter Sidebar
  Desktop: left sidebar panel
  Mobile: off-canvas drawer with toggle button
{%- endcomment -%}

<!-- Mobile Filter Toggle Button -->
<button class="filter-toggle" id="filterToggle" aria-label="ফিল্টার খুলুন">
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 4h16M5 10h10M8 16h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
  ফিল্টার করুন
</button>

<!-- Filter Overlay (mobile) -->
<div class="filter-overlay" id="filterOverlay"></div>

<!-- Filter Sidebar / Drawer -->
<aside class="collection-filter" id="collectionFilter">
  <div class="collection-filter__header">
    <h3 class="collection-filter__title">{{ section.settings.title }}</h3>
    <button class="collection-filter__reset" type="button" onclick="resetAllFilters()">সব রিসেট</button>
    <button class="collection-filter__close" id="filterClose" aria-label="বন্ধ করুন">&times;</button>
  </div>

  <form class="collection-filter__form" id="filterForm">
    <!-- মূল্য সীমা -->
    <div class="collection-filter__group">
      <h4 class="collection-filter__group-title">মূল্য সীমা</h4>
      <div class="collection-filter__price-range">
        <div class="collection-filter__price-input">
          <label for="filter-price-min">সর্বনিম্ন</label>
          <div class="collection-filter__input-wrap">
            <span class="collection-filter__currency">৳</span>
            <input
              type="number"
              id="filter-price-min"
              name="filter.v.price.gte"
              min="0"
              max="{{ section.settings.max_price }}"
              value="0"
              placeholder="0"
            >
          </div>
        </div>
        <span class="collection-filter__price-sep">—</span>
        <div class="collection-filter__price-input">
          <label for="filter-price-max">সর্বোচ্চ</label>
          <div class="collection-filter__input-wrap">
            <span class="collection-filter__currency">৳</span>
            <input
              type="number"
              id="filter-price-max"
              name="filter.v.price.lte"
              min="0"
              max="{{ section.settings.max_price }}"
              value="{{ section.settings.max_price }}"
              placeholder="{{ section.settings.max_price }}"
            >
          </div>
        </div>
      </div>
    </div>

    <!-- পণ্যের ধরন (Tags) -->
    <div class="collection-filter__group">
      <h4 class="collection-filter__group-title">পণ্যের ধরন</h4>
      <div class="collection-filter__checkboxes">
        {%- if collection != blank and collection.all_tags.size > 0 -%}
          {%- for tag in collection.all_tags -%}
            <label class="collection-filter__checkbox">
              <input
                type="checkbox"
                name="filter.tag"
                value="{{ tag | handleize }}"
                {%- if current_tags contains tag %} checked{%- endif -%}
              >
              <span class="collection-filter__checkmark"></span>
              <span class="collection-filter__label-text">{{ tag }}</span>
            </label>
          {%- endfor -%}
        {%- else -%}
          <p class="collection-filter__empty">কোনো ট্যাগ পাওয়া যায়নি</p>
        {%- endif -%}
      </div>
    </div>

    <!-- উপলব্ধতা -->
    <div class="collection-filter__group">
      <h4 class="collection-filter__group-title">উপলব্ধতা</h4>
      <div class="collection-filter__checkboxes">
        <label class="collection-filter__checkbox">
          <input type="checkbox" name="filter.v.availability" value="1" checked>
          <span class="collection-filter__checkmark"></span>
          <span class="collection-filter__label-text">স্টকে আছে</span>
        </label>
        <label class="collection-filter__checkbox">
          <input type="checkbox" name="filter.v.availability" value="0">
          <span class="collection-filter__checkmark"></span>
          <span class="collection-filter__label-text">স্টকে নেই</span>
        </label>
      </div>
    </div>

    <!-- Apply Button -->
    <button type="submit" class="collection-filter__apply btn-primary">
      ফিল্টার প্রয়োগ করুন
    </button>
  </form>
</aside>

<style>
  .filter-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--color-primary, #f60);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 16px;
  }

  .filter-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .collection-filter {
    width: 280px;
    flex-shrink: 0;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 20px;
  }

  .collection-filter__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .collection-filter__title {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0;
  }

  .collection-filter__reset {
    background: none;
    border: none;
    color: var(--color-primary, #f60);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
  }

  .collection-filter__close {
    display: none;
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: #666;
    padding: 0;
  }

  .collection-filter__group {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  .collection-filter__group:last-of-type {
    border-bottom: none;
  }

  .collection-filter__group-title {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 12px;
  }

  .collection-filter__price-range {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .collection-filter__price-input {
    flex: 1;
  }

  .collection-filter__price-input label {
    display: block;
    font-size: 12px;
    color: #666;
    margin-bottom: 4px;
  }

  .collection-filter__input-wrap {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    overflow: hidden;
  }

  .collection-filter__currency {
    padding: 8px;
    background: #f3f4f6;
    font-size: 14px;
    color: #666;
    border-right: 1px solid #d1d5db;
  }

  .collection-filter__input-wrap input {
    border: none;
    padding: 8px;
    width: 100%;
    font-size: 14px;
    outline: none;
  }

  .collection-filter__price-sep {
    font-size: 16px;
    color: #999;
    padding-bottom: 8px;
  }

  .collection-filter__checkboxes {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .collection-filter__checkbox {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 14px;
    color: #333;
  }

  .collection-filter__checkbox input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--color-primary, #f60);
    cursor: pointer;
  }

  .collection-filter__empty {
    font-size: 13px;
    color: #999;
    margin: 0;
  }

  .collection-filter__apply {
    width: 100%;
    padding: 12px;
    background: var(--color-primary, #f60);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 8px;
    transition: background 0.2s;
  }

  .collection-filter__apply:hover {
    background: #7628D7;
  }

  @media (max-width: 768px) {
    .filter-toggle {
      display: inline-flex;
    }

    .collection-filter {
      position: fixed;
      top: 0;
      left: -320px;
      height: 100vh;
      z-index: 1000;
      border-radius: 0;
      overflow-y: auto;
      transition: left 0.3s ease;
      width: 300px;
    }

    .collection-filter.is-open {
      left: 0;
    }

    .collection-filter__close {
      display: block;
    }

    .filter-overlay.is-active {
      display: block;
    }
  }
</style>

<script>
  (function() {
    const toggle = document.getElementById('filterToggle');
    const sidebar = document.getElementById('collectionFilter');
    const overlay = document.getElementById('filterOverlay');
    const close = document.getElementById('filterClose');

    function openFilter() {
      sidebar.classList.add('is-open');
      overlay.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }

    function closeFilter() {
      sidebar.classList.remove('is-open');
      overlay.classList.remove('is-active');
      document.body.style.overflow = '';
    }

    if (toggle) toggle.addEventListener('click', openFilter);
    if (close) close.addEventListener('click', closeFilter);
    if (overlay) overlay.addEventListener('click', closeFilter);
  })();

  function resetAllFilters() {
    var form = document.getElementById('filterForm');
    if (form) {
      form.reset();
      var minInput = document.getElementById('filter-price-min');
      var maxInput = document.getElementById('filter-price-max');
      if (minInput) minInput.value = '0';
      if (maxInput) maxInput.value = maxInput.getAttribute('max');
    }
  }
</script>

<script src="{{ 'filters.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "🔍 কালেকশন ফিল্টার",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "ফিল্টার শিরোনাম",
      "default": "ফিল্টার করুন"
    },
    {
      "type": "range",
      "id": "max_price",
      "label": "সর্বোচ্চ মূল্য সীমা",
      "min": 1000,
      "max": 100000,
      "step": 1000,
      "default": 50000,
      "unit": "৳"
    }
  ],
  "presets": [
    {
      "name": "🔍 কালেকশন ফিল্টার"
    }
  ]
}
{% endschema %}
