{%- if section.settings.show_announcement -%}
<div class="announcement-bar">
  <div class="container">
    <div class="announcement-bar__inner">
      {%- for copy in (1..2) -%}
        <div class="announcement-bar__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
          <div class="announcement-bar__item"><span>🚚</span><span>{{ section.settings.item_1 }}</span></div>
          <span class="announcement-bar__divider">|</span>
          <div class="announcement-bar__item"><span>💵</span><span>{{ section.settings.item_2 }}</span></div>
          <span class="announcement-bar__divider">|</span>
          <div class="announcement-bar__item"><span>🛡️</span><span>{{ section.settings.item_3 }}</span></div>
          <span class="announcement-bar__divider">|</span>
          <div class="announcement-bar__item"><span>🎧</span><span>{{ section.settings.item_4 }}</span></div>
          <span class="announcement-bar__divider">|</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

<style>
  .announcement-bar {
    background-color: #1B3C3C;
    color: #fff;
    font-size: 13px;
    padding: 8px 0;
    overflow: hidden;
    font-family: var(--font-bengali, 'Hind Siliguri', sans-serif);
  }
  .announcement-bar .container {
    max-width: none;
    margin: 0 auto;
    padding: 0;
  }
  .announcement-bar__inner {
    display: flex;
    align-items: center;
    width: max-content;
    flex-wrap: nowrap;
    animation: announcement-marquee 32s linear infinite;
  }
  .announcement-bar:hover .announcement-bar__inner {
    animation-play-state: paused;
  }
  .announcement-bar__group {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-right: 16px;
    flex-shrink: 0;
  }
  @keyframes announcement-marquee {
    to { transform: translateX(-50%); }
  }
  .announcement-bar__item {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .announcement-bar__divider {
    color: rgba(255,255,255,0.3);
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__inner {
      animation-duration: 80s;
    }
  }
</style>

{% schema %}
{
  "name": "📢 অ্যানাউন্সমেন্ট বার",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "অ্যানাউন্সমেন্ট বার দেখান",
      "default": true
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "আইটেম ১",
      "default": "সারাদেশে ডেলিভারি"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "আইটেম ২",
      "default": "ক্যাশ অন ডেলিভারি"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "আইটেম ৩",
      "default": "নিরাপদ কেনাকাটা"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "আইটেম ৪",
      "default": "সকাল ৯টা - রাত ১০টা কাস্টমার সাপোর্ট"
    }
  ]
}
{% endschema %}
