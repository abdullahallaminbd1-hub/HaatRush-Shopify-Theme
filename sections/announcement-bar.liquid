<div class="lf-announcement" role="region" aria-label="{{ 'general.announcements' | t }}">
  <div class="lf-announcement__track">
    {%- for i in (1..2) -%}
      {%- if section.settings.message_1 != blank -%}<span>{{ section.settings.message_1 }}</span>{%- endif -%}
      {%- if section.settings.message_2 != blank -%}<span>{{ section.settings.message_2 }}</span>{%- endif -%}
      {%- if section.settings.message_3 != blank -%}<span>{{ section.settings.message_3 }}</span>{%- endif -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {"type":"text","id":"message_1","label":"Message 1","default":"হাটরাশে স্বাগতম — ইলেকট্রনিক্স ও দরকারি গ্যাজেট"},
    {"type":"text","id":"message_2","label":"Message 2","default":"ক্যাশ অন ডেলিভারি সুবিধা"},
    {"type":"text","id":"message_3","label":"Message 3","default":"নিরাপদ চেকআউট · গ্রাহক সহায়তা · স্পষ্ট ডেলিভারি তথ্য"}
  ],
  "presets": [{"name": "Announcement bar"}]
}
{% endschema %}