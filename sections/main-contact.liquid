<section class="cf"><div class="cf__inner">

  <header class="cf__hero">
    <span class="cf__eyebrow" data-reveal>HaatRush / customer care</span>
    <h1 class="cf__title" data-reveal style="--d:.08s">Contact us</h1>
    <p class="cf__lede" data-reveal style="--d:.16s">Questions about an order, a product, or delivery? Send us a note and our team will help.</p>
  </header>

  <div class="cf__grid">

    <aside class="cf__aside">
      <h2 class="cf__aside-title" data-reveal>We&rsquo;re here to help.</h2>
      <ul class="cf__cards">
        <li class="cf__card" data-reveal style="--d:.22s">
          <span class="cf__card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg></span>
          <span class="cf__card-body"><span class="cf__card-label">Email</span><a class="cf__card-value" href="mailto:support@haatrush.com">support@haatrush.com</a></span>
        </li>
        <li class="cf__card" data-reveal style="--d:.3s">
          <span class="cf__card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.4V12l3.1 2.1"/></svg></span>
          <span class="cf__card-body"><span class="cf__card-label">Response time</span><span class="cf__card-value">Usually within one business day.</span></span>
        </li>
        <li class="cf__card" data-reveal style="--d:.38s">
          <span class="cf__card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z"/></svg></span>
          <span class="cf__card-body"><span class="cf__card-label">Customer support</span><span class="cf__card-value">For order support, include your order number so we can get back to you quickly.</span></span>
        </li>
      </ul>
    </aside>

    <div class="cf__panel" data-reveal style="--d:.18s">
      {%- form 'contact', class: 'cf__form' -%}
        {%- if form.posted_successfully? -%}<div class="cf__success">Thanks &mdash; your message has been received.</div>{%- endif -%}
        {{ form.errors | default_errors }}
        <div class="cf__field">
          <input class="cf__input" id="cf-name" type="text" name="contact[name]" required placeholder=" ">
          <label class="cf__label" for="cf-name">Name</label>
        </div>
        <div class="cf__field">
          <input class="cf__input" id="cf-email" type="email" name="contact[email]" required placeholder=" ">
          <label class="cf__label" for="cf-email">Email</label>
        </div>
        <div class="cf__field">
          <input class="cf__input" id="cf-order" type="text" name="contact[order_number]" placeholder=" ">
          <label class="cf__label" for="cf-order">Order number <span class="cf__opt">(optional)</span></label>
        </div>
        <div class="cf__field cf__field--area">
          <textarea class="cf__textarea" id="cf-message" name="contact[body]" rows="5" required placeholder=" "></textarea>
          <label class="cf__label" for="cf-message">Message</label>
        </div>
        <button class="button button--accent cf__submit" type="submit">Send message <span>&rarr;</span></button>
      {%- endform -%}
    </div>

  </div>
</div></section>
{% schema %}{"name":"Contact page","settings":[],"presets":[{"name":"Contact page"}]}{% endschema %}