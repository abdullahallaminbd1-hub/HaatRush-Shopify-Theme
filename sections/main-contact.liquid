<section class="cf"><div class="cf__inner">

  <header class="cf__hero">
    <span class="cf__eyebrow" data-reveal>হাটরাশ / গ্রাহক সেবা</span>
    <h1 class="cf__title" data-reveal style="--d:.08s">যোগাযোগ করুন</h1>
    <p class="cf__lede" data-reveal style="--d:.16s">অর্ডার, পণ্য বা ডেলিভারি নিয়ে কোনো প্রশ্ন আছে? আমাদের লিখুন—আমাদের দল আপনাকে সহায়তা করবে।</p>
  </header>

  <div class="cf__grid">

    <aside class="cf__aside">
      <h2 class="cf__aside-title" data-reveal>আমরা আপনাকে সহায়তা করতে প্রস্তুত।</h2>
      <ul class="cf__cards">
        <li class="cf__card" data-reveal style="--d:.22s">
          <span class="cf__card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg></span>
          <span class="cf__card-body"><span class="cf__card-label">ইমেইল</span><a class="cf__card-value" href="mailto:support@haatrush.com">support@haatrush.com</a></span>
        </li>
        <li class="cf__card" data-reveal style="--d:.3s">
          <span class="cf__card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.4V12l3.1 2.1"/></svg></span>
          <span class="cf__card-body"><span class="cf__card-label">উত্তরের সময়</span><span class="cf__card-value">সাধারণত এক কর্মদিবসের মধ্যে।</span></span>
        </li>
        <li class="cf__card" data-reveal style="--d:.38s">
          <span class="cf__card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z"/></svg></span>
          <span class="cf__card-body"><span class="cf__card-label">গ্রাহক সহায়তা</span><span class="cf__card-value">অর্ডার-সংক্রান্ত সহায়তার জন্য অর্ডার নম্বরটি দিন, তাহলে আমরা দ্রুত উত্তর দিতে পারব।</span></span>
        </li>
      </ul>
    </aside>

    <div class="cf__panel" data-reveal style="--d:.18s">
      {%- form 'contact', class: 'cf__form' -%}
        {%- if form.posted_successfully? -%}<div class="cf__success">ধন্যবাদ—আপনার বার্তাটি পেয়েছি।</div>{%- endif -%}
        {{ form.errors | default_errors }}
        <div class="cf__field">
          <input class="cf__input" id="cf-name" type="text" name="contact[name]" required placeholder=" ">
          <label class="cf__label" for="cf-name">নাম</label>
        </div>
        <div class="cf__field">
          <input class="cf__input" id="cf-email" type="email" name="contact[email]" required placeholder=" ">
          <label class="cf__label" for="cf-email">ইমেইল</label>
        </div>
        <div class="cf__field">
          <input class="cf__input" id="cf-order" type="text" name="contact[order_number]" placeholder=" ">
          <label class="cf__label" for="cf-order">অর্ডার নম্বর <span class="cf__opt">(ঐচ্ছিক)</span></label>
        </div>
        <div class="cf__field cf__field--area">
          <textarea class="cf__textarea" id="cf-message" name="contact[body]" rows="5" required placeholder=" "></textarea>
          <label class="cf__label" for="cf-message">বার্তা</label>
        </div>
        <button class="button button--accent cf__submit" type="submit">বার্তা পাঠান <span>&rarr;</span></button>
      {%- endform -%}
    </div>

  </div>
</div></section>
{% schema %}{"name":"Contact page","settings":[],"presets":[{"name":"Contact page"}]}{% endschema %}