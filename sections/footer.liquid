<footer class="lf-footer">
  <div class="lf-footer__wave" aria-hidden="true"></div>
  <div class="lf-footer__inner page-width">
    <div class="lf-footer__grid">
      <div class="lf-footer__brand">
        <a class="lf-footer__logo-card" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            <img
              class="lf-footer__logo-img"
              src="{{ section.settings.logo | image_url: width: 400 }}"
              srcset="{{ section.settings.logo | image_url: width: 100 }} 100w, {{ section.settings.logo | image_url: width: 200 }} 200w, {{ section.settings.logo | image_url: width: 300 }} 300w, {{ section.settings.logo | image_url: width: 400 }} 400w"
              sizes="{{ section.settings.logo_width | default: 140 }}px"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              loading="lazy"
              style="width:{{ section.settings.logo_width | default: 140 }}px">
          {%- else -%}
            <span class="lf-wordmark lf-wordmark--footer">Haat<i>Rush</i></span>
          {%- endif -%}
        </a>
        <p>{{ settings.brand_tagline | default: 'ইলেকট্রনিক্স, গ্যাজেট ও প্রতিদিনের প্রয়োজনীয় ডিভাইস' }}</p>
        <div class="lf-footer__social">
          <a href="{{ settings.instagram_url | default: '#' }}" aria-label="ইনস্টাগ্রাম">{% render 'icon', icon: 'instagram' %}</a>
          <a href="{{ settings.tiktok_url | default: '#' }}" aria-label="টিকটক">{% render 'icon', icon: 'tiktok' %}</a>
          <a href="{{ settings.facebook_url | default: '#' }}" aria-label="ফেসবুক">{% render 'icon', icon: 'facebook' %}</a>
        </div>
      </div>

      <div class="lf-footer__column">
        <span class="lf-footer__label">{{ 'sections.footer.shop' | t }}</span>
        {%- if section.settings.menu_shop != blank and section.settings.menu_shop.links.size > 0 -%}
          {%- for link in section.settings.menu_shop.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          <a href="{{ routes.collections_url }}/electronics">ইলেকট্রনিক্স</a>
          <a href="{{ routes.collections_url }}/gadgets">গ্যাজেট</a>
          <a href="{{ routes.collections_url }}/audio">অডিও</a>
          <a href="{{ routes.collections_url }}/smart-devices">স্মার্ট ডিভাইস</a>
          <a href="{{ routes.collections_url }}/accessories">অ্যাক্সেসরিজ</a>
          <a href="{{ routes.collections_url }}/under-2000">৳২,০০০-এর মধ্যে</a>
        {%- endif -%}
      </div>

      <div class="lf-footer__column">
        <span class="lf-footer__label">{{ 'sections.footer.customer_care' | t }}</span>
        {%- if section.settings.menu_customer_care != blank and section.settings.menu_customer_care.links.size > 0 -%}
          {%- for link in section.settings.menu_customer_care.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          <a href="{{ routes.root_url }}pages/contact-us">যোগাযোগ</a>
          <a href="{{ routes.root_url }}pages/track-order">অর্ডার ট্র্যাক করুন</a>
          <a href="/policies/shipping-policy">ডেলিভারি নীতি</a>
          <a href="/policies/refund-policy">রিটার্ন ও রিফান্ড</a>
          <a href="/policies/privacy-policy">গোপনীয়তা নীতি</a>
          <a href="/policies/terms-of-service">শর্তাবলি</a>
        {%- endif -%}
      </div>

      <div class="lf-footer__column lf-footer__column--contact">
        <span class="lf-footer__label">{{ 'sections.footer.get_in_touch' | t }}</span>
        <a href="mailto:{{ settings.contact_email | default: 'support@haatrush.com' }}">✉ {{ settings.contact_email | default: 'support@haatrush.com' }}</a>
        <span>▣ গ্রাহক সহায়তা উপলভ্য</span>
        <div class="lf-footer__pay-box">
          <strong>{{ 'sections.footer.secure_payment' | t }}</strong>
          <div class="lf-footer__pay-grid">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>
          <small>{{ 'sections.footer.payment_note' | t }}</small>
        </div>
      </div>
    </div>

    <div class="lf-footer__trust">
      <div><span>◇</span> {{ 'sections.footer.secure_payment' | t }}</div>
      <div><span>▣</span> {{ 'general.announcement_3' | t }}</div>
      <div><span>↺</span> {{ 'general.returns' | t }}</div>
    </div>

    <div class="lf-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.copyright' | t }}</span>
      <span class="lf-footer__bottom-links"><a href="/policies/privacy-policy">{{ 'general.privacy_policy' | t }}</a> • <a href="/policies/terms-of-service">{{ 'general.terms' | t }}</a> • <a href="/policies/refund-policy">{{ 'general.returns' | t }}</a></span>
    </div>
  </div>
</footer>
{% schema %}{"name":"Footer","settings":[{"type":"image_picker","id":"logo","label":"Footer logo image","info":"Optional. Upload a PNG, JPEG or GIF logo. Leave empty to keep the default HaatRush wordmark."},{"type":"range","id":"logo_width","label":"Footer logo width","min":60,"max":300,"step":10,"unit":"px","default":140,"info":"Applied only when a footer logo image is selected."},{"type":"link_list","id":"menu_shop","label":"Shop menu","info":"Optional. Leave empty to use the default collection links."},{"type":"link_list","id":"menu_customer_care","label":"Customer Care menu","info":"Optional. Leave empty to use the default pages and policies."}],"presets":[{"name":"Footer"}]}{% endschema %}