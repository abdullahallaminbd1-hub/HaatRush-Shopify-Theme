{%- assign whatsapp_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      {%- comment -%} ===== COL 1: BRAND ===== {%- endcomment -%}
      <div class="site-footer__col site-footer__col--brand">
        <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="HaatRush হোম">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FF6B00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="site-footer__logo-text">{{ section.settings.logo_text | default: "HaatRush" }}</span>
        </a>
        <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
        <div class="site-footer__social">
          {%- if settings.facebook_url != blank -%}
            <a href="{{ settings.facebook_url }}" class="site-footer__social-link site-footer__social-link--facebook" aria-label="Facebook" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.youtube_url != blank -%}
            <a href="{{ settings.youtube_url }}" class="site-footer__social-link site-footer__social-link--youtube" aria-label="YouTube" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.instagram_url != blank -%}
            <a href="{{ settings.instagram_url }}" class="site-footer__social-link site-footer__social-link--instagram" aria-label="Instagram" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.x_url != blank -%}
            <a href="{{ settings.x_url }}" class="site-footer__social-link site-footer__social-link--x" aria-label="X / Twitter" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if whatsapp_number != blank -%}
            <a href="https://wa.me/{{ whatsapp_number }}" class="site-footer__social-link site-footer__social-link--whatsapp" aria-label="WhatsApp" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ===== COL 2: QUICK LINKS ===== {%- endcomment -%}
      <div class="site-footer__col">
        <h4 class="site-footer__heading">দ্রুত লিংক</h4>
        <ul class="site-footer__links">
          <li><a href="{{ section.settings.link_home_url | default: '/' }}">{{ section.settings.link_home_label | default: 'হোম' }}</a></li>
          <li><a href="{{ section.settings.link_products_url | default: '/collections/all' }}">{{ section.settings.link_products_label | default: 'সব পণ্য' }}</a></li>
          <li><a href="{{ section.settings.link_deals_url | default: '/collections/deals' }}">{{ section.settings.link_deals_label | default: 'আজকের ডিল' }}</a></li>
          <li><a href="{{ section.settings.link_cart_url | default: '/cart' }}">{{ section.settings.link_cart_label | default: 'কার্ট' }}</a></li>
          <li><a href="{{ section.settings.link_about_url | default: '/pages/about' }}">{{ section.settings.link_about_label | default: 'আমাদের সম্পর্কে' }}</a></li>
        </ul>
      </div>

      {%- comment -%} ===== COL 3: CUSTOMER SERVICE ===== {%- endcomment -%}
      <div class="site-footer__col">
        <h4 class="site-footer__heading">গ্রাহক সেবা</h4>
        <ul class="site-footer__links">
          <li><a href="{{ section.settings.link_guide_url | default: '/pages/shopping-guide' }}">{{ section.settings.link_guide_label | default: 'কেনাকাটা গাইড' }}</a></li>
          <li><a href="{{ section.settings.link_delivery_url | default: '/pages/delivery' }}">{{ section.settings.link_delivery_label | default: 'ডেলিভারি তথ্য' }}</a></li>
          <li><a href="{{ section.settings.link_return_url | default: '/pages/return-refund' }}">{{ section.settings.link_return_label | default: 'রিটার্ন ও রিফান্ড' }}</a></li>
          <li><a href="{{ section.settings.link_privacy_url | default: '/pages/privacy-policy' }}">{{ section.settings.link_privacy_label | default: 'গোপনীয়তা নীতি' }}</a></li>
          <li><a href="{{ section.settings.link_terms_url | default: '/pages/terms' }}">{{ section.settings.link_terms_label | default: 'শর্তাবলী' }}</a></li>
        </ul>
      </div>

      {%- comment -%} ===== COL 4: CONTACT ===== {%- endcomment -%}
      <div class="site-footer__col">
        <h4 class="site-footer__heading">যোগাযোগ</h4>
        <ul class="site-footer__contact">
          {%- if section.settings.contact_email != blank -%}
            <li class="site-footer__contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF6B00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.contact_address != blank -%}
            <li class="site-footer__contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF6B00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span>{{ section.settings.contact_address }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.contact_hours != blank -%}
            <li class="site-footer__contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF6B00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>{{ section.settings.contact_hours }}</span>
            </li>
          {%- endif -%}
        </ul>
        {%- if whatsapp_number != blank -%}
          <a href="https://wa.me/{{ whatsapp_number }}" class="site-footer__whatsapp-button" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            <span>আমাদের সাথে যোগাযোগ করুন</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ===== BOTTOM BAR ===== {%- endcomment -%}
    <div class="site-footer__bottom">
      <div class="site-footer__bottom-inner">
        <p class="site-footer__copyright">
          &copy; 2024 HaatRush. সর্বস্ব সংরক্ষিত।
        </p>
        <div class="site-footer__payments">
          <span class="site-footer__payment-badge site-footer__payment-badge--bkash">bKash</span>
          <span class="site-footer__payment-badge site-footer__payment-badge--nagad">Nagad</span>
          <span class="site-footer__payment-badge site-footer__payment-badge--rocket">Rocket</span>
          <span class="site-footer__payment-badge site-footer__payment-badge--cod">ক্যাশ অন ডেলিভারি</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #1B3C3C;
    color: #fff;
    padding: 60px 0 0;
    font-size: 14px;
  }
  .site-footer .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  /* Logo & Brand */
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .site-footer__logo-text {
    font-size: 22px;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.5px;
  }
  .site-footer__tagline {
    color: rgba(255,255,255,0.65);
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 20px;
  }

  /* Social */
  .site-footer__social {
    display: flex;
    gap: 12px;
  }
  .site-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    color: #fff;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .site-footer__social-link:hover {
    background: #fff;
    transform: translateY(-2px);
  }
  .site-footer__social-link--facebook:hover { color: #1877F2; }
  .site-footer__social-link--youtube:hover { color: #FF0000; }
  .site-footer__social-link--instagram:hover { color: #C13584; }
  .site-footer__social-link--whatsapp:hover { color: #25D366; }

  /* Column Headings */
  .site-footer__heading {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 16px;
    color: #fff;
    position: relative;
    padding-bottom: 10px;
  }
  .site-footer__heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: #FF6B00;
    border-radius: 2px;
  }

  /* Links */
  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer__links li {
    margin-bottom: 10px;
  }
  .site-footer__links a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.2s, padding-left 0.2s;
    font-size: 13px;
  }
  .site-footer__links a:hover {
    color: #FF6B00;
    padding-left: 4px;
  }

  /* Contact */
  .site-footer__contact {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 12px;
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    line-height: 1.5;
  }
  .site-footer__contact-item svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .site-footer__contact-item a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.2s;
  }
  .site-footer__contact-item a:hover {
    color: #FF6B00;
  }
  .site-footer__whatsapp-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    margin-top: 4px;
    border-radius: 8px;
    background: #25D366;
    color: #fff;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s ease;
  }
  .site-footer__whatsapp-button:hover {
    background: #1fb958;
  }

  /* Bottom Bar */
  .site-footer__bottom {
    padding: 20px 0;
    border-top: 1px solid rgba(255,255,255,0.15);
  }
  .site-footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .site-footer__copyright {
    color: rgba(255,255,255,0.5);
    font-size: 12px;
    margin: 0;
  }
  .site-footer__payments {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .site-footer__payment-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
  }
  .site-footer__payment-badge--bkash {
    background: #E2146C;
    color: #fff;
  }
  .site-footer__payment-badge--nagad {
    background: #FF6B00;
    color: #fff;
  }
  .site-footer__payment-badge--rocket {
    background: #8B2FC9;
    color: #fff;
  }
  .site-footer__payment-badge--cod {
    background: #FF6B00;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.3);
    box-shadow: 0 2px 4px rgba(255,107,0,0.3);
    animation: cod-pulse 2s infinite;
  }

  @keyframes cod-pulse {
    0%, 100% { box-shadow: 0 2px 4px rgba(255,107,0,0.3); }
    50% { box-shadow: 0 4px 8px rgba(255,107,0,0.5); }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .site-footer {
      padding: 40px 0 0;
    }
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }
    .site-footer__col--brand {
      grid-column: 1 / -1;
    }
    .site-footer__bottom-inner {
      flex-direction: column;
      text-align: center;
    }
    .site-footer__payments {
      justify-content: center;
    }
  }
  @media (max-width: 480px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "📋 ফুটার",
  "settings": [
    {
      "type": "header",
      "content": "ব্র্যান্ড তথ্য"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "লোগো টেক্সট",
      "default": "HaatRush"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "ট্যাগলাইন",
      "default": "বাংলাদেশের বিশ্বস্ত অনলাইন ইলেকট্রনিক্স স্টোর। সেরা দামে অরিজিনাল প্রোডাক্ট, ক্যাশ অন ডেলিভারিতে ঘরে বসে অর্ডার করুন।"
    },
    {
      "type": "header",
      "content": "সোশ্যাল মিডিয়া"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "ফেসবুক লিংক"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "ইউটিউব লিংক"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "ইনস্টাগ্রাম লিংক"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "হোয়াটসঅ্যাপ লিংক"
    },
    {
