<section class="home-hero{% if section.settings.hero_image != blank %} home-hero--image{% endif %} page-width"{% if section.settings.hero_image != blank %} style="--hero-image: url('{{ section.settings.hero_image | image_url: width: 2000 }}');"{% endif %}>
  <div class="home-hero__copy">
    <h1>{{ section.settings.hero_title }}</h1>
    <p>{{ section.settings.hero_text | escape }}</p>
    <div class="home-hero__buttons">
      <a class="button button--primary" href="{{ section.settings.hero_button_link | default: routes.all_products_collection_url }}">{{ section.settings.hero_button_label | escape }}</a>
      <a class="button button--outline-light" href="{{ routes.all_products_collection_url }}">{{ section.settings.secondary_button_label | escape }}</a>
    </div>
  </div>
</section>

<section class="page-width home-products">
  <div class="section-heading">
    <div><span class="section-heading__icon" aria-hidden="true">🔥</span><h2>{{ section.settings.featured_heading | escape }}</h2></div>
    {% if section.settings.featured_collection != blank %}
      <a href="{{ section.settings.featured_collection.url }}">সব দেখুন <span aria-hidden="true">→</span></a>
    {% endif %}
  </div>
  {% if section.settings.featured_collection != blank and section.settings.featured_collection.products_count > 0 %}
    <div class="product-grid product-grid--home">
      {% for product in section.settings.featured_collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <p class="home-empty-state">এই সংগ্রহে এখনো কোনো পণ্য নেই।</p>
  {% endif %}
</section>

<section class="page-width home-products home-products--popular">
  <div class="section-heading">
    <div><span class="section-heading__icon" aria-hidden="true">★</span><h2>{{ section.settings.popular_heading | escape }}</h2></div>
    {% if section.settings.popular_collection != blank %}
      <a href="{{ section.settings.popular_collection.url }}">সব দেখুন <span aria-hidden="true">→</span></a>
    {% endif %}
  </div>
  {% if section.settings.popular_collection != blank and section.settings.popular_collection.products_count > 0 %}
    <div class="product-grid product-grid--home">
      {% for product in section.settings.popular_collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <p class="home-empty-state">এই সংগ্রহে এখনো কোনো পণ্য নেই।</p>
  {% endif %}
</section>

<section class="page-width benefits-strip" aria-label="আমাদের সুবিধা">
  <div class="benefit">{% render 'icon', name: 'truck' %}<div><strong>সারা দেশে ডেলিভারি</strong><span>বাংলাদেশের সব জেলায়</span></div></div>
  <div class="benefit">{% render 'icon', name: 'cash' %}<div><strong>ক্যাশ অন ডেলিভারি</strong><span>পণ্য হাতে পেয়ে মূল্য দিন</span></div></div>
  <div class="benefit">{% render 'icon', name: 'shield' %}<div><strong>নিরাপদ কেনাকাটা</strong><span>নিশ্চিন্তে অর্ডার করুন</span></div></div>
  <div class="benefit">{% render 'icon', name: 'headset' %}<div><strong>কাস্টমার সাপোর্ট</strong><span>আমরা আপনার পাশে</span></div></div>
</section>

{% schema %}
{
  "name": "হোমপেজ",
  "settings": [
    { "type": "inline_richtext", "id": "hero_title", "label": "হিরো শিরোনাম", "default": "ঘরে বসেই কিনুন <em>প্রয়োজনীয়</em> ইলেকট্রনিক্স" },
    { "type": "textarea", "id": "hero_text", "label": "হিরো বিবরণ", "default": "বিশ্বস্ত ব্র্যান্ড, সেরা দামে—আপনার দৈনন্দিন জীবনের জন্য।" },
    { "type": "image_picker", "id": "hero_image", "label": "হিরো ব্যানার ছবি" },
    { "type": "text", "id": "hero_button_label", "label": "প্রধান বাটনের লেখা", "default": "এখনই কিনুন" },
    { "type": "url", "id": "hero_button_link", "label": "প্রধান বাটনের লিংক" },
    { "type": "text", "id": "secondary_button_label", "label": "দ্বিতীয় বাটনের লেখা", "default": "সব পণ্য দেখুন" },
    { "type": "collection", "id": "featured_collection", "label": "আজকের সেরা ডিল সংগ্রহ" },
    { "type": "text", "id": "featured_heading", "label": "প্রথম সংগ্রহের শিরোনাম", "default": "আজকের সেরা ডিল" },
    { "type": "collection", "id": "popular_collection", "label": "জনপ্রিয় পণ্যের সংগ্রহ" },
    { "type": "text", "id": "popular_heading", "label": "দ্বিতীয় সংগ্রহের শিরোনাম", "default": "জনপ্রিয় পণ্য" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 4, "step": 1, "default": 4, "label": "প্রতি সংগ্রহে পণ্য" }
  ]
}
{% endschema %}
