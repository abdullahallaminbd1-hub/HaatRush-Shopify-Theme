{%- comment -%}
  HaatRush Theme - Badge Snippet
  Accepts:
  - type: {String} 'discount', 'stock', 'sale', 'outline'
  - text: {String} Custom text (optional)
  - product: {Object} Product object (optional)
{%- endcomment -%}

{%- case type -%}
  {%- when 'discount' -%}
    {%- if product and product.compare_at_price > product.price -%}
      {%- assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
      <span class="badge badge--discount">-{{ discount }}%</span>
    {%- elsif text != blank -%}
      <span class="badge badge--discount">{{ text }}</span>
    {%- endif -%}

  {%- when 'stock' -%}
    {%- if product != blank -%}
      {%- if product.available -%}
        <span class="badge badge--stock">
          <span class="badge__dot"></span> স্টক আছে
        </span>
      {%- else -%}
        <span class="badge badge--out-of-stock">স্টক নেই</span>
      {%- endif -%}
    {%- elsif text != blank -%}
      <span class="badge badge--stock">{{ text }}</span>
    {%- endif -%}

  {%- when 'outline' -%}
    <span class="badge badge--outline">{{ text }}</span>

  {%- else -%}
    <span class="badge">{{ text }}</span>
{%- endcase -%}
