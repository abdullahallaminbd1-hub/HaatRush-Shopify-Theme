<div class="drawer-backdrop" data-drawer-close></div>
<aside class="cart-drawer" aria-label="{{ 'general.cart' | t }}" data-cart-drawer>
  <header class="drawer__header"><h2 class="drawer__title">{{ 'general.your_cart' | t }} <span class="drawer__meta"><span data-cart-count>{{ cart.item_count }}</span> {{ 'sections.cart.items' | t }}</span></h2><button class="icon-button" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button></header>
  <div class="drawer__body" data-cart-body>
    {%- assign ship_threshold = 100000 -%}
    {%- assign bundle_target = 2 -%}
    {%- assign ship_done = false -%}
    {%- if cart.total_price >= ship_threshold -%}{%- assign ship_done = true -%}{%- endif -%}
    {%- assign bundle_done = false -%}
    {%- if cart.item_count >= bundle_target -%}{%- assign bundle_done = true -%}{%- endif -%}
    {%- assign ship_left = ship_threshold | minus: cart.total_price -%}
    {%- assign bundle_progress = cart.item_count | at_most: bundle_target -%}
    {%- assign shipping_progress = cart.total_price | at_most: ship_threshold -%}
    {%- assign ship_pct = 0 -%}
    {%- if ship_done -%}
      {%- assign ship_pct = 100 -%}
    {%- elsif cart.total_price > 0 -%}
      {%- assign ship_pct = cart.total_price | times: 100.0 | divided_by: ship_threshold | round -%}
      {%- if ship_pct > 99 -%}{%- assign ship_pct = 99 -%}{%- endif -%}
    {%- endif -%}
    {%- assign bundle_pct = cart.item_count | times: 100.0 | divided_by: bundle_target | round -%}
    {%- if bundle_pct > 100 -%}{%- assign bundle_pct = 100 -%}{%- endif -%}
    <div class="drawer-offers" data-cart-offers data-bundle-target="{{ bundle_target }}" data-shipping-threshold="{{ ship_threshold }}">
      <section class="drawer-offer{% if bundle_done %} is-complete{% endif %}" data-bundle-offer{% if bundle_done %} data-complete="true"{% endif %}>
        <div class="drawer-offer__track" role="progressbar" aria-valuemin="0" aria-valuemax="{{ bundle_target }}" aria-valuenow="{{ bundle_progress }}" aria-label="বান্ডেল সেভিংসের অগ্রগতি">
          <i class="drawer-offer__fill" data-bundle-fill style="width:{{ bundle_pct }}%"></i>
        </div>
        <p class="drawer-offer__label">বান্ডেল সেভিংস</p>
        <p class="drawer-offer__subtitle">২টি পণ্য কিনুন, ২% ছাড় পান</p>
        <p class="drawer-offer__status" data-bundle-status aria-live="polite">{% if bundle_done %}অভিনন্দন! আপনি ২% ছাড়ের জন্য যোগ্য।{% else %}আর {{ bundle_target | minus: cart.item_count }}টি পণ্য যোগ করুন{% endif %}</p>
      </section>
      <section class="drawer-offer{% if ship_done %} is-complete{% endif %}" data-shipping-offer{% if ship_done %} data-complete="true"{% endif %}>
        <div class="drawer-offer__track" role="progressbar" aria-valuemin="0" aria-valuemax="{{ ship_threshold }}" aria-valuenow="{{ shipping_progress }}" aria-label="ফ্রি শিপিংয়ের অগ্রগতি">
          <i class="drawer-offer__fill" data-shipping-fill style="width:{{ ship_pct }}%"></i>
        </div>
        <p class="drawer-offer__label">ফ্রি শিপিং</p>
        <p class="drawer-offer__subtitle">৳১,০০০ বা তার বেশি কেনাকাটায় ফ্রি ডেলিভারি</p>
        <p class="drawer-offer__status" data-shipping-status aria-live="polite">{% if ship_done %}অভিনন্দন! আপনার অর্ডারে ফ্রি ডেলিভারি প্রযোজ্য।{% else %}আর {{ ship_left | money }} খরচ করুন{% endif %}</p>
      </section>
    </div>
    {% if cart.item_count == 0 %}<div class="empty-state"><div class="empty-state__mark">◇</div><h3>{{ 'general.empty_cart' | t }}</h3><p>{{ 'general.no_products' | t }}</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>{% else %}<div class="cart-items">{% for item in cart.items %}<div class="cart-item"><div class="cart-item__image">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag }}{% endif %}</div><div class="cart-item__main"><div class="cart-item__head"><h3 class="cart-item__title">{{ item.product.title }}</h3><button type="button" class="cart-item__remove" data-remove-item data-line="{{ forloop.index }}" aria-label="{{ 'general.remove' | t }}: {{ item.product.title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"/><path d="M6.5 7l.9 11.1A2 2 0 0 0 9.4 20h5.2a2 2 0 0 0 2-1.9L17.5 7"/><path d="M9.5 7V5.2A1.2 1.2 0 0 1 10.7 4h2.6a1.2 1.2 0 0 1 1.2 1.2V7"/></svg></button></div>{% unless item.variant.title == 'Default Title' %}<p class="cart-item__variant">{{ item.variant.title }}</p>{% endunless %}<div class="cart-item__foot"><div class="quantity-control"><button type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'general.decrease_quantity' | t }}: {{ item.product.title | escape }}">−</button><span>{{ item.quantity }}</span><button type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'general.increase_quantity' | t }}: {{ item.product.title | escape }}">＋</button></div><span class="cart-item__price">{{ item.final_line_price | money }}</span></div></div></div>{% endfor %}</div>{% endif %}
    <div class="drawer-recommendations"><div class="drawer-recommendations__head"><span class="eyebrow">{{ 'sections.product.related_products' | t }}</span><a class="drawer-recommendations__all" href="{{ routes.all_products_collection_url }}">{{ 'general.view_all' | t }} <span aria-hidden="true">→</span></a></div>
      {%- assign drawer_recs = collections.all.products -%}
      {%- assign drawer_ids = '' -%}{%- for it in cart.items -%}{%- assign drawer_ids = drawer_ids | append: it.product_id | append: ',' -%}{%- endfor -%}
      {%- assign drawer_shown = 0 -%}
      <div class="drawer-recommendations__row">
        {%- for rec in drawer_recs -%}
          {%- if drawer_shown >= 4 -%}{%- break -%}{%- endif -%}
          {%- assign rec_key = rec.id | append: ',' -%}
          {%- if drawer_ids contains rec_key -%}{%- continue -%}{%- endif -%}
          {%- if rec.available == false -%}{%- continue -%}{%- endif -%}
          <div class="drawer-rec">
            <a class="drawer-rec__media" href="{{ rec.url }}" aria-label="পণ্য দেখুন: {{ rec.title | escape }}">
              {%- if rec.featured_image -%}{{ rec.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,300', alt: rec.featured_image.alt | default: rec.title }}{%- endif -%}
            </a>
            {%- if rec.selected_or_first_available_variant -%}
              <button type="button" class="drawer-rec__add" data-quick-add="{{ rec.selected_or_first_available_variant.id }}" aria-label="{{ 'general.add_to_cart' | t }}: {{ rec.title | escape }}">+</button>
            {%- endif -%}
            <p class="drawer-rec__title">{{ rec.title }}</p>
            <p class="drawer-rec__price">{{ rec.price | money }}</p>
          </div>
          {%- assign drawer_shown = drawer_shown | plus: 1 -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  <footer class="drawer__footer"><div class="drawer-total"><span>{{ 'sections.cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><a class="button button--accent button--full drawer__checkout" href="{{ routes.root_url }}pages/checkout">চেকআউট · {{ cart.total_price | money }}</a><p class="payment-note">{{ 'sections.cart.note' | t }}</p></footer>
</aside>