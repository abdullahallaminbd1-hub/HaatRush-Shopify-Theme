<article class="lf-product-card">
  <a class="lf-product-card__media" href="{{ product.url }}" aria-label="{{ 'products.view_product' | t }}: {{ product.title | escape }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360,540,800', sizes: '(max-width: 750px) 50vw, 25vw', class: 'lf-product-card__image lf-product-card__image--primary', alt: product.featured_image.alt | default: product.title }}
      {%- assign card_second = product.images[1] -%}
      {%- if card_second -%}
        {{ card_second | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360,540,800', sizes: '(max-width: 750px) 50vw, 25vw', class: 'lf-product-card__image lf-product-card__image--secondary', alt: card_second.alt | default: product.title }}
      {%- endif -%}
    {%- else -%}
      <div class="lf-product-card__placeholder">HR</div>
    {%- endif -%}
    {%- if badge != blank -%}<span class="lf-badge">{{ badge }}</span>
    {%- elsif product.compare_at_price > product.price -%}<span class="lf-badge">{{ 'products.sale_badge' | t }}</span>
    {%- endif -%}
    {%- if product.available == false -%}<span class="lf-badge lf-badge--sold">{{ 'products.sold_out' | t }}</span>{%- endif -%}
    {%- if arrow -%}<span class="lf-card-arrow" aria-hidden="true">↗</span>{%- endif -%}
  </a>
  <div class="lf-product-card__info">
    {%- comment -%} Title (single line) + genuine subtitle. No ratings, no add-to-cart. {%- endcomment -%}
    <h3 class="lf-product-card__title"><a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title }}</a></h3>
    {%- assign card_subtitle = product.metafields.custom.subtitle.value | default: product.metafields.custom.short_description.value | default: product.metafields.custom.card_subtitle.value | default: product.metafields.custom.tagline.value -%}
    {%- if card_subtitle == blank and product.type != blank -%}{%- assign card_subtitle = product.type -%}{%- endif -%}
    {%- if card_subtitle == blank and product.description != blank -%}{%- assign card_subtitle = product.description | strip_html | replace: '\n', ' ' | strip | truncate: 72 -%}{%- endif -%}
    <p class="lf-product-card__subtitle"{% if card_subtitle == blank %} aria-hidden="true"{% endif %}>{{ card_subtitle | escape }}</p>
    {%- assign show_compare = false -%}
    {%- if product.compare_at_price and product.compare_at_price > product.price -%}{%- assign show_compare = true -%}{%- endif -%}
    <div class="lf-product-card__price">
      <span class="lf-price">{{ product.price | money }}</span>
      {%- if show_compare -%}
        <s class="lf-compare">{{ product.compare_at_price | money }}</s>
        {%- assign save_off = product.compare_at_price | minus: product.price -%}
        {%- assign save_pct = save_off | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="lf-save">{{ 'products.save_percent' | t }} {{ save_pct }}%</span>
      {%- endif -%}
    </div>
    <div class="lf-product-card__actions">
      {%- comment -%} Cards link to the product page; add-to-cart lives on that page. {%- endcomment -%}
      <a class="lf-card-btn lf-card-btn--{{ button_style | default: 'filled' }}" href="{{ product.url }}" aria-label="{{ 'products.view_product' | t }}: {{ product.title | escape }}"><span class="lf-card-btn__label">{{ 'products.view_product' | t }}</span><span class="lf-card-btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
      {%- if show_view_details -%}<a class="lf-card-view" href="{{ product.url }}">{{ 'products.view_details' | t }} <span aria-hidden="true">→</span></a>{%- endif -%}
    </div>
  </div>
</article>