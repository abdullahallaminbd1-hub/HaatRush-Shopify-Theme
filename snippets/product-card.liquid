{%- comment -%}
  HaatRush Theme - Product Card Snippet
  Accepts:
  - product: {Object} Shopify Product Drop
  - show_badge: {Boolean} Whether to show discount badge (default: true)
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
-%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__image-wrap">
    {%- if show_badge != false and has_discount -%}
      <span class="product-card__badge">-{{ discount_percent }}%</span>
    {%- endif -%}

    <a href="{{ product.url }}" class="product-card__image-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 600 | image_tag:
          alt: product.featured_image.alt | default: product.title,
          class: 'product-card__image',
          loading: 'lazy',
          widths: '165, 360, 500, 600',
          sizes: '(min-width: 1024px) 25vw, (min-width: 641px) 50vw, 100vw'
        }}
      {%- else -%}
        <div class="product-card__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
        </div>
      {%- endif -%}
    </a>
  </div>

  <div class="product-card__body">
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {%- if product.metafields.custom.subtitle != blank -%}
      <p class="product-card__subtitle">{{ product.metafields.custom.subtitle }}</p>
    {%- elsif product.description != blank -%}
      <p class="product-card__subtitle">{{ product.description | strip_html | truncate: 45 }}</p>
    {%- else -%}
      <p class="product-card__subtitle" aria-hidden="true"></p>
    {%- endif -%}

    <div class="product-card__footer">
      <div class="product-card__prices">
        <span class="product-card__price">{{ current_variant.price | money }}</span>
        {%- if has_discount -%}
          <span class="product-card__compare">{{ current_variant.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {%- if product.available -%}
        <button
          type="button"
          class="btn-primary product-card__btn js-ajax-add-to-cart"
          data-variant-id="{{ current_variant.id }}"
          data-add-to-cart
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span>কার্টে যোগ করুন</span>
        </button>
      {%- else -%}
        <button type="button" class="btn-primary product-card__btn is-disabled" disabled style="opacity: 0.55; cursor: not-allowed; background: var(--color-strike);">
          <span>স্টক শেষ</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
