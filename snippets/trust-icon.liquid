{%- comment -%}
  HaatRush Theme - Trust Icon Snippet
  Accepts:
  - icon: {String} 'truck' | 'money' | 'shield' | 'headphone'
  - title: {String} Bengali Title
  - description: {String} Bengali Subtext
{%- endcomment -%}

<div class="trust-item">
  <div class="trust-item__icon-wrap">
    {%- case icon -%}
      {%- when 'truck' -%}
        <svg class="trust-item__svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#7628D7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13" rx="2"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>

      {%- when 'money' -%}
        <svg class="trust-item__svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#7628D7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <line x1="2" y1="10" x2="22" y2="10"></line>
          <circle cx="12" cy="15" r="2"></circle>
        </svg>

      {%- when 'shield' -%}
        <svg class="trust-item__svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#7628D7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 12 11 14 15 10"></polyline>
        </svg>

      {%- when 'headphone' -%}
        <svg class="trust-item__svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#7628D7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
          <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
        </svg>
    {%- endcase -%}
  </div>

  <div class="trust-item__content">
    {%- if title != blank -%}
      <h4 class="trust-item__title">{{ title }}</h4>
    {%- endif -%}
    {%- if description != blank -%}
      <p class="trust-item__desc">{{ description }}</p>
    {%- endif -%}
  </div>
</div>
