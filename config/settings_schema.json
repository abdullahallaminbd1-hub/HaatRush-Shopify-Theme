[
  {
    "name": "theme_info",
    "theme_name": "HaatRush",
    "theme_version": "2.0.0",
    "theme_author": "HaatRush",
    "theme_documentation_url": "https://haatrush.com",
    "theme_support_url": "https://haatrush.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand tagline",
        "default": "ইলেকট্রনিক্স, গ্যাজেট ও প্রতিদিনের প্রয়োজনীয় ডিভাইস"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink",
        "default": "#27183A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#7628D7"
      },
      {
        "type": "color",
        "id": "color_sand",
        "label": "হালকা ব্যাকগ্রাউন্ড",
        "default": "#F8F3FF"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Contact email",
        "default": "support@haatrush.com"
      }
    ]
  },
  {
    "name": "Hero",
    "settings": [
      {
        "type": "header",
        "content": "Homepage hero height"
      },
      {
        "type": "range",
        "id": "hero_height_desktop",
        "label": "Desktop Hero Height",
        "info": "Height of the homepage hero on screens wider than 989px.",
        "min": 400,
        "max": 900,
        "step": 10,
        "unit": "px",
        "default": 620
      },
      {
        "type": "range",
        "id": "hero_height_mobile",
        "label": "Mobile Hero Height",
        "info": "Height of the homepage hero on mobile and tablet screens (up to 989px).",
        "min": 320,
        "max": 760,
        "step": 10,
        "unit": "px",
        "default": 480
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "instagram_url",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "tiktok_url",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "facebook_url",
        "label": "Facebook URL"
      }
    ]
  },
  {
    "name": "Cart & promotions",
    "settings": [
      {
        "type": "header",
        "content": "Cart progress strip"
      },
      {
        "type": "checkbox",
        "id": "cart_promo_enabled",
        "label": "Show cart progress strip",
        "info": "Shows a progress bar in the cart drawer and on the cart page. Only enable this once the matching discount or shipping offer is configured in Shopify Admin, and set the label below to match that offer exactly.",
        "default": false
      },
      {
        "type": "range",
        "id": "cart_promo_threshold",
        "label": "Offer threshold (currency units)",
        "info": "The cart subtotal at which the offer applies. Enter the value in your store currency.",
        "min": 0,
        "max": 100000,
        "step": 100,
        "default": 7500
      },
      {
        "type": "text",
        "id": "cart_promo_label",
        "label": "Progress label",
        "info": "লেবেল লুকাতে ফাঁকা রাখুন। সক্রিয় অফারের সঙ্গে মিল রেখে লিখুন, যেমন: \"৳১,৫০০-এর বেশি অর্ডারে ডেলিভারি সুবিধা\"।",
        "default": ""
      },
      {
        "type": "text",
        "id": "cart_promo_reached_label",
        "label": "Label when the offer is reached",
        "default": ""
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "header",
        "content": "Product card width"
      },
      {
        "type": "select",
        "id": "product_card_width_mode",
        "label": "Card width mode",
        "info": "Box Width caps every product card at the pixel width set below. Full Width lets cards fill their grid column with no fixed width.",
        "options": [
          {
            "value": "box",
            "label": "Box Width"
          },
          {
            "value": "full",
            "label": "Full Width"
          }
        ],
        "default": "full"
      },
      {
        "type": "range",
        "id": "product_card_width",
        "label": "Card width (px)",
        "info": "Used only when Card width mode is set to Box Width.",
        "min": 200,
        "max": 500,
        "step": 10,
        "unit": "px",
        "default": 340
      }
    ]
  }
]
